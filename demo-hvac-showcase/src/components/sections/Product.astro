---
// rol: el dashboard interactivo. Vive una sola vez, en su sección, porque el
// island mantiene estado y los e2e del funnel dependen de él.
import { Dashboard } from '../Dashboard';
import { ui } from '../../i18n/strings';

interface Props { locale?: 'en' | 'es' }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
---

<section id="product" class="border-b border-hvac-border-real bg-hvac-surface">
  <div class="mx-auto max-w-7xl px-4 py-16 lg:py-20">
    <header class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.dashboard.eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold leading-tight text-hvac-text md:text-5xl">
        {t.sections.dashboard.headline}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-hvac-muted">{t.sections.dashboard.body}</p>
    </header>

    <div class="mt-8">
      <Dashboard client:load locale={locale} />
    </div>
  </div>
</section>
