---
// rol: el recorrido del producto en bento, no cinco cards iguales. Una celda la
// ocupa la ilustración del técnico: el mismo argumento, en el punto donde se
// resuelve el problema.
import { ui } from '../../i18n/strings';
import Technician from '../illustrations/Technician.astro';

interface Props { locale?: 'en' | 'es' }
const { locale = 'en' } = Astro.props;
const t = ui[locale];

const COPY = {
  en: { bubble: 'dispatched', caption: 'The closest tech, already moving' },
  es: { bubble: 'despachado', caption: 'El técnico más cercano, ya en camino' },
};
const c = COPY[locale];

const stepIcons = [
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/>',
  '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/>',
  '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  '<path d="M3 11l19-9-9 19-2-8-8-2z"/>',
  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>',
];
---

<section class="border-b border-hvac-border-real bg-hvac-base">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:py-24">
    <header class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.solution.eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold leading-tight text-hvac-text md:text-5xl">
        {t.sections.solution.headline}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-hvac-muted">{t.sections.solution.body}</p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col justify-center rounded-xl border border-hvac-border-real bg-gradient-to-br from-hvac-neutral to-hvac-brand/10 p-5 shadow-card sm:col-span-2 lg:col-span-1 lg:row-span-2">
        <Technician bubble={c.bubble} />
        <p class="mt-2 text-center text-xs font-semibold uppercase tracking-wide text-hvac-muted">{c.caption}</p>
      </div>

      {t.solutionSteps.map((step, i) => (
        <article class="rounded-xl border border-hvac-border-real bg-hvac-surface p-5 shadow-card transition-shadow hover:shadow-elevated">
          <div class="flex items-center justify-between">
            <span class="flex h-9 w-9 items-center justify-center rounded-md border border-hvac-brand bg-hvac-brand/10 text-hvac-brand">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stepIcons[i]} />
            </span>
            <span class="font-display text-3xl font-bold text-hvac-border-real">0{i + 1}</span>
          </div>
          <h3 class="mt-3 font-display text-lg font-semibold uppercase tracking-wide text-hvac-text">{step.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-hvac-muted">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
