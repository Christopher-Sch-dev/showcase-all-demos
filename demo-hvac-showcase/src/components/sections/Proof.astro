---
// rol: prueba con fuente. El dato citado manda y la etiqueta del tipo de prueba
// va en mono, para que se distinga evidencia de opinión.
import { getNiche } from '../../config/niches';
import { ui, esCopy } from '../../i18n/strings';

interface Props { locale?: 'en' | 'es' }
const { locale = 'en' } = Astro.props;

const entry = getNiche('a', 'hvac')!;
const config = entry.config;
const t = ui[locale];
const copy = locale === 'es' ? esCopy : config;

const COPY = {
  en: { statistic: 'Statistic', case_study: 'Case study', testimonial: 'Testimonial', source: 'Source' },
  es: { statistic: 'Estadística', case_study: 'Caso real', testimonial: 'Testimonio', source: 'Fuente' },
};
const c = COPY[locale];

const badgeClass: Record<string, string> = {
  statistic: 'border-hvac-brand text-hvac-brand',
  case_study: 'border-hvac-accent text-hvac-accent',
  testimonial: 'border-hvac-on-route text-hvac-on-route',
};
---

<section class="border-b border-hvac-border-real bg-hvac-base">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:py-24">
    <header class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.proof.eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold leading-tight text-hvac-text md:text-5xl">
        {t.sections.proof.headline}
      </h2>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-3 md:grid-cols-2">
      {copy.proof.map((p, i) => (
        <article class:list={['rounded-xl border border-hvac-border-real bg-hvac-surface p-5 shadow-card', i === 0 && 'md:col-span-2']}>
          <span class:list={['inline-block rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-widest', badgeClass[p.type]]}>
            {c[p.type]}
          </span>
          <p class:list={['mt-3 leading-relaxed text-hvac-text', i === 0 ? 'text-lg md:text-xl' : 'text-base']}>{p.text}</p>
          {p.source && (
            <a href={p.source} target="_blank" rel="noreferrer"
              class="mt-2 inline-block font-mono text-[11px] uppercase tracking-wide text-hvac-muted underline-offset-2 hover:text-hvac-brand hover:underline">
              {c.source}
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="mt-6 rounded-xl border border-hvac-border-real bg-hvac-surface p-5">
      <h3 class="font-display text-base font-semibold uppercase tracking-widest text-hvac-muted">
        {t.integrationsTitle}
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {config.integrations.map((it) => (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-hvac-border-real bg-hvac-base px-3 py-1 text-xs font-semibold text-hvac-text">
            <span class="h-1.5 w-1.5 rounded-full bg-hvac-on-route" aria-hidden="true"></span>
            {it.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
