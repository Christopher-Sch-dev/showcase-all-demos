---
// rol: el técnico que sí llega. Cierra el argumento: la llamada se capturó, el
// trabajo se despachó y la camioneta va en camino. Misma familia visual que
// MissedCall (flat, geométrico, tokens hvac-*).
interface Props {
  class?: string;
  /** Texto opcional del globo. Omitir = sin globo. */
  bubble?: string;
}

const { class: className = '', bubble } = Astro.props;
---

<svg
  class:list={['technician', className]}
  viewBox="0 0 300 230"
  role="img"
  aria-label="Técnico de climatización junto a su camioneta, en camino a un trabajo"
>
  {bubble && (
    <g transform="translate(206 14)">
      <rect x="0" y="0" width="82" height="30" rx="9" class="fill-hvac-surface stroke-hvac-on-route" stroke-width="1.8" />
      <path d="M10 30l-3 9 11-9" class="fill-hvac-surface stroke-hvac-on-route" stroke-width="1.8" stroke-linejoin="round" />
      <text
        x="41" y="19"
        text-anchor="middle"
        class="fill-hvac-on-route"
        font-family="'Barlow Condensed', sans-serif"
        font-size="13"
        font-weight="700"
        letter-spacing="0.4">{bubble}</text>
    </g>
  )}

  <!-- fondo -->
  <ellipse cx="150" cy="196" rx="128" ry="20" class="fill-hvac-steel" opacity="0.07" />

  <!-- ruta -->
  <g class="stroke-hvac-accent" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="7 7" fill="none" opacity="0.45">
    <path d="M18 186h44c14 0 22-8 26-18" />
  </g>

  <!-- camioneta -->
  <g>
    <!-- caja -->
    <rect x="150" y="96" width="104" height="66" rx="7" class="fill-hvac-brand" />
    <!-- cabina -->
    <path d="M150 162V116c0-11 6-20 18-20h14l14 26h8c10 0 16 6 16 14v26h-70Z" class="fill-hvac-brand" opacity="0.92" />
    <!-- parabrisas -->
    <path d="M168 104h12l12 22h-24Z" class="fill-hvac-surface" opacity="0.92" />
    <!-- techo de carga -->
    <rect x="196" y="108" width="46" height="24" rx="3" class="fill-hvac-surface" opacity="0.35" />
    <!-- logo -->
    <g transform="translate(222 138)">
      <circle r="13" class="fill-hvac-surface" opacity="0.95" />
      <text x="0" y="5" text-anchor="middle" class="fill-hvac-brand"
        font-family="'Barlow Condensed', sans-serif" font-size="15" font-weight="700">h</text>
    </g>
    <!-- ruedas -->
    <circle cx="176" cy="166" r="14" class="fill-hvac-steel" />
    <circle cx="176" cy="166" r="6" class="fill-hvac-surface" />
    <circle cx="232" cy="166" r="14" class="fill-hvac-steel" />
    <circle cx="232" cy="166" r="6" class="fill-hvac-surface" />
    <!-- faro -->
    <rect x="148" y="142" width="6" height="9" rx="2" class="fill-hvac-accent" />
  </g>

  <!-- técnico -->
  <g transform="translate(96 88)">
    <!-- piernas -->
    <g class="fill-hvac-steel" opacity="0.88">
      <rect x="-9" y="52" width="13" height="44" rx="6" />
      <rect x="6" y="52" width="13" height="44" rx="6" />
    </g>
    <!-- botas -->
    <g class="fill-hvac-steel">
      <rect x="-12" y="90" width="19" height="9" rx="4" />
      <rect x="4" y="90" width="19" height="9" rx="4" />
    </g>
    <!-- torso -->
    <path d="M-17 8c0-8 7-14 16-15h10c9 1 16 7 16 15v34c0 6-4 10-10 10H-7c-6 0-10-4-10-10V8Z" class="fill-hvac-brand" />
    <!-- franja reflectante -->
    <path d="M-17 30h50" class="stroke-hvac-surface" stroke-width="4" opacity="0.85" />
    <!-- brazo con llave -->
    <path d="M17 16c7 3 11 9 11 17" class="stroke-hvac-brand" stroke-width="11" stroke-linecap="round" fill="none" />
    <g transform="translate(31 40) rotate(18)">
      <g class="stroke-hvac-steel" stroke-width="3.4" stroke-linecap="round" fill="none">
        <path d="M0 0v16" />
        <path d="M-5 -3a5 5 0 1 1 10 0" />
      </g>
    </g>
    <!-- brazo izquierdo -->
    <path d="M-17 16c-6 4-8 10-8 17" class="stroke-hvac-brand" stroke-width="11" stroke-linecap="round" fill="none" />
    <circle cx="-26" cy="37" r="6.5" class="fill-hvac-surface" style="fill:#E8B48E" />

    <!-- cabeza -->
    <circle cx="0" cy="-18" r="20" style="fill:#E8B48E" />
    <!-- gorra -->
    <path d="M-20 -24c0-12 9-20 20-20s20 8 20 20c-3-6-7-9-11-10-3 4-9 5-15 4-6-1-10 1-14 6Z" class="fill-hvac-brand" />
    <path d="M8 -24h20c3 0 4 2 3 4l-2 3H8Z" class="fill-hvac-brand-strong" />
    <!-- cara -->
    <g class="fill-hvac-steel" opacity="0.85">
      <circle cx="-6" cy="-16" r="2.2" />
      <circle cx="6" cy="-16" r="2.2" />
    </g>
    <path d="M-4 -9c2.6 2.8 5.4 2.8 8 0" class="stroke-hvac-steel" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.6" />
  </g>
</svg>

<style>
  .technician {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
