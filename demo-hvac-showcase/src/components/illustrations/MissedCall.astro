---
// rol: la llamada que nadie contesta. Es el argumento de la página: mientras el
// técnico está en la calle, el teléfono suena y el trabajo se va a la competencia.
// Colores tomados de los tokens hvac-* del Tailwind config, no de literales.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['missed-call', className]}
  viewBox="0 0 260 240"
  role="img"
  aria-label="Teléfono sonando con una llamada perdida"
>
  <!-- fondo -->
  <circle cx="126" cy="120" r="102" class="fill-hvac-neutral" opacity="0.7" />
  <circle cx="126" cy="120" r="74" class="fill-hvac-surface" opacity="0.9" />

  <!-- ondas de la llamada -->
  <g class="stroke-hvac-brand" fill="none" stroke-linecap="round" opacity="0.55">
    <path d="M40 74a58 58 0 0 0 0 92" stroke-width="3.4" />
    <path d="M28 58a82 82 0 0 0 0 124" stroke-width="3" opacity="0.6" />
    <path d="M212 74a58 58 0 0 1 0 92" stroke-width="3.4" />
    <path d="M224 58a82 82 0 0 1 0 124" stroke-width="3" opacity="0.6" />
  </g>

  <!-- teléfono -->
  <g transform="rotate(-7 126 130)">
    <rect x="92" y="52" width="68" height="146" rx="12" class="fill-hvac-steel" />
    <rect x="99" y="64" width="54" height="118" rx="6" class="fill-hvac-surface" />
    <rect x="116" y="56" width="20" height="4" rx="2" class="fill-hvac-text" opacity="0.4" />

    <!-- icono de llamada perdida en pantalla -->
    <g transform="translate(126 108)">
      <circle r="21" class="fill-hvac-urgent" opacity="0.12" />
      <g class="stroke-hvac-urgent" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M-8 -7c-3 3-3 7 0 10 3 5 8 9 13 11 3 2 7 1 9-2l1-2-5-3-2 2c-4-2-7-5-9-9l2-2-3-5-2 1Z" />
        <path d="M6 -9 17 -9 17 2" />
      </g>
    </g>

    <!-- etiqueta MISSED -->
    <g transform="translate(126 152)">
      <rect x="-31" y="-11" width="62" height="22" rx="6" class="fill-hvac-urgent" />
      <text
        x="0" y="4"
        text-anchor="middle"
        class="fill-hvac-surface"
        font-family="ui-monospace, monospace"
        font-size="10"
        font-weight="700"
        letter-spacing="1.2">MISSED</text>
    </g>
  </g>

  <!-- contador de la plata que se va -->
  <g transform="translate(196 60)">
    <rect x="-26" y="-14" width="52" height="28" rx="14" class="fill-hvac-surface stroke-hvac-border-real" stroke-width="1.6" />
    <text
      x="0" y="4.5"
      text-anchor="middle"
      class="fill-hvac-urgent"
      font-family="'Barlow Condensed', sans-serif"
      font-size="15"
      font-weight="700">$2,200</text>
  </g>
</svg>

<style>
  .missed-call {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
