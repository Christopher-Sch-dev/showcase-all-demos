---
// LAYOUT BASE demo-hvac — chrome compartido (head SEO, fonts, nav, footer).
// i18n manual: props locale ('en' | 'es') + ui strings resueltos por locale.
// NAV: logo demo-hvac + toggle idioma (EN ↔ ES) + badge MODE DEMO.
// FOOTER: honestidad (métricas con fuente / proyecciones estimadas) + año.
import { ui } from '../i18n/strings';
import { SITE_URL, seoMeta, seoFaq, localePaths } from '../i18n/seo';

interface Props {
  title: string;
  description: string;
  locale: 'en' | 'es';
}

const { title, description, locale } = Astro.props;
const t = ui[locale];
const meta = seoMeta[locale];
const faq = seoFaq[locale];
// link del toggle de idioma: en EN → /es/, en ES → /
const localeHref = locale === 'en' ? '/es/' : '/';
const year = new Date().getFullYear();
const htmlLang = locale;
const canonical = `${SITE_URL}${localePaths[locale]}`;
const canonicalAlt = locale === 'en' ? `${SITE_URL}/es/` : `${SITE_URL}/`;
const pageUrl = canonical;

// JSON-LD (Schema.org) — capa AEO/GEO que los AI crawlers / LLM leen.
// Service + Offer + Organization + ContactPage (proyecto P4 del CANON) + FAQPage.
const schemaOrg = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${SITE_URL}/#service`,
      name: 'HVAC Call-Capture + Dispatch — AI Receptionist',
      serviceType: 'AI receptionist for field-service HVAC businesses',
      description:
        'Captures missed HVAC calls, qualifies and books leads, dispatches the closest technician, and invoices on completion — in one board.',
      url: canonical,
      provider: { '@id': `${SITE_URL}/#organization` },
      areaServed: 'Global',
      audience: { '@type': 'BusinessAudience', name: 'HVAC / field-service small businesses' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        description: 'Custom software + AI add-on for HVAC businesses. Book a 20-min demo call.',
        url: 'https://calendly.com/csch1305',
        seller: { '@id': `${SITE_URL}/#organization` },
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'demo-hvac',
      url: SITE_URL,
      sameAs: [],
    },
    {
      '@type': 'ContactPage',
      '@id': `${SITE_URL}/#contact`,
      name: 'Book a demo call',
      url: 'https://calendly.com/csch1305',
      mainEntity: { '@id': `${SITE_URL}/#service` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE_URL}/#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
});

---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang (en/es) + alternates -->
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/`} />
    <link rel="alternate" hreflang="es" href={`${SITE_URL}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
    <link rel="alternate" href={canonicalAlt} hreflang={locale === 'en' ? 'es' : 'en'} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="demo-hvac" />
    <meta property="og:locale" content={meta.localeTag} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${SITE_URL}${meta.ogImage}`} />
    <meta property="og:image:alt" content="demo-hvac — AI receptionist for HVAC call-capture and dispatch" />
    <meta property="og:image:type" content="image/svg+xml" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={`${SITE_URL}${meta.ogImage}`} />

    <!-- JSON-LD Schema.org (Service / Offer / Organization / ContactPage / FAQPage) -->
    <script type="application/ld+json" set:html={schemaOrg} />

    <!-- Fonts: Barlow Condensed (display), Inter (body), JetBrains Mono (estados) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-hvac-base text-hvac-text antialiased">
    <!-- ── NAV ── -->
    <header class="sticky top-0 z-20 border-b border-hvac-border-real bg-hvac-base/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <a href={locale === 'en' ? '/' : '/es/'} class="flex items-center gap-2" aria-label="demo-hvac">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-hvac-brand font-display text-base font-bold text-white"
            >h</span
          >
          <span class="font-display text-lg font-bold uppercase tracking-wide text-hvac-text">{t.nav.brand}</span>
        </a>

        <div class="flex items-center gap-3">
          <!-- Toggle idioma -->
          <a
            href={localeHref}
            title={t.nav.localeTitle}
            class="inline-flex items-center gap-1.5 rounded-md border border-hvac-border-real bg-hvac-surface px-2.5 py-1 text-xs font-semibold text-hvac-text transition-colors hover:bg-hvac-neutral"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            {t.nav.localeSwitch}
          </a>

          <!-- Badge MODE DEMO -->
          <span class="inline-flex items-center gap-1.5 rounded-full border border-hvac-urgent bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wide text-hvac-urgent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-hvac-urgent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-hvac-urgent"></span>
            </span>
            {t.badge}
          </span>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ── FOOTER (honestidad) ── -->
    <footer class="border-t border-hvac-border-real bg-hvac-surface">
      <div class="mx-auto max-w-7xl space-y-4 px-4 py-10">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <a href={locale === 'en' ? '/' : '/es/'} class="flex items-center gap-2" aria-label="demo-hvac">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-hvac-brand font-display text-base font-bold text-white"
              >h</span
            >
            <span class="font-display text-lg font-bold uppercase tracking-wide text-hvac-text">{t.footer.brand}</span>
          </a>
          <p class="font-mono text-[11px] uppercase tracking-wide text-hvac-muted">
            © {year} {t.footer.brand} · {t.footer.rights}
          </p>
        </div>
        <p class="max-w-2xl text-xs text-hvac-muted">{t.footer.metricsSourced}</p>
        <p class="max-w-2xl text-xs text-hvac-muted">{t.footer.demoDisclaimer}</p>
      </div>
    </footer>
  </body>
</html>
