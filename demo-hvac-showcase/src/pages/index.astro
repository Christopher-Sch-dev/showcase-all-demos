---
// LANDING DE VENTA — EN default (`/`). Composición de secciones: el problema se
// cuenta con la ilustración, el producto se muestra una vez y el CTA cierra.
// Todo el copy viene de la config del nicho y de i18n. Acá no hay texto de venta.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Pain from '../components/sections/Pain.astro';
import Steps from '../components/sections/Steps.astro';
import Product from '../components/sections/Product.astro';
import Proof from '../components/sections/Proof.astro';
import Roi from '../components/sections/Roi.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { getNiche } from '../config/niches';

const entry = getNiche('a', 'hvac');
if (!entry) {
  return Astro.redirect('/');
}

const pageTitle = `${entry.config.name} — demo`;
const pageDescription =
  'Interactive demo: capture missed calls, dispatch techs, and recover revenue with an AI receptionist.';
---

<BaseLayout title={pageTitle} description={pageDescription} locale="en">
  <Hero locale="en" />
  <Pain locale="en" />
  <Steps locale="en" />
  <Product locale="en" />
  <Proof locale="en" />
  <Roi locale="en" />
  <FinalCta locale="en" />
</BaseLayout>
