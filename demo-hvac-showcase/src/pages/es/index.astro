---
// LANDING DE VENTA — ES es-CL neutro (`/es/`). Misma composición que EN.
// El copy de hero/pain/proof viene de esCopy (la config hvac es EN).
// CTA SIEMPRE a Calendly (config.cta.url), NUNCA mailto.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Pain from '../../components/sections/Pain.astro';
import Steps from '../../components/sections/Steps.astro';
import Product from '../../components/sections/Product.astro';
import Proof from '../../components/sections/Proof.astro';
import Roi from '../../components/sections/Roi.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { getNiche } from '../../config/niches';

const entry = getNiche('a', 'hvac');
if (!entry) {
  return Astro.redirect('/es/');
}

const pageTitle = `${entry.config.name} — demo`;
const pageDescription =
  'Demo interactiva: captura llamadas perdidas, despacha técnicos y recupera ingresos con una recepción por IA.';
---

<BaseLayout title={pageTitle} description={pageDescription} locale="es">
  <Hero locale="es" />
  <Pain locale="es" />
  <Steps locale="es" />
  <Product locale="es" />
  <Proof locale="es" />
  <Roi locale="es" />
  <FinalCta locale="es" />
</BaseLayout>
