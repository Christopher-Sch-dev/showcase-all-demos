---
// LANDING DE VENTA — ES es-CL neutro (`/es/`). Misma estructura que EN, copy traducido.
// Tuteo 'tú', NUNCA rioplatense. Terminología HVAC neutra.
// Hero/pain/proof vienen de esCopy (strings.ts) porque la config hvac es EN.
// CTA SIEMPRE a Calendly (config.cta.url), NUNCA mailto.
import { getNiche } from '../../config/niches';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Dashboard } from '../../components/Dashboard';
import { ROICalculator } from '../../components/ROICalculator';
import { ui, esCopy } from '../../i18n/strings';

const entry = getNiche('a', 'hvac');
if (!entry) {
  return Astro.redirect('/es/');
}
const config = entry.config;
const locale = 'es';
const t = ui.es;
const c = esCopy;

const pageTitle = `${config.name} — demo`;
const pageDescription = 'Demo interactiva: captura llamadas perdidas, despacha técnicos y recupera ingresos con una recepción por IA.';
const year = new Date().getFullYear();

const stepIcons = [
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/>',
  '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/>',
  '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  '<path d="M3 11l19-9-9 19-2-8-8-2z"/>',
  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>',
];
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale}>
  <!-- ── HERO ── -->
  <section class="mx-auto max-w-7xl px-4 pt-14 pb-6">
    <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{c.hero.eyebrow}</p>
    <h1 class="mt-2 max-w-3xl font-display text-5xl font-bold leading-tight text-hvac-text md:text-6xl">
      {c.hero.headline}
    </h1>
    <p class="mt-3 max-w-2xl font-body text-lg text-hvac-muted">{c.hero.subheadline}</p>
    <div class="mt-6">
      <a
        href={config.cta.url}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-hvac-brand bg-hvac-brand px-6 py-3 font-display text-lg font-bold uppercase tracking-wide text-white transition-colors hover:bg-hvac-brand-strong"
      >
        {c.hero.ctaLabel}
      </a>
    </div>
  </section>

  <!-- ── PAIN POINT + 3 métricas con source ── -->
  <section class="mx-auto max-w-7xl px-4 py-8">
    <div class="rounded-lg border border-hvac-border-real bg-hvac-surface p-6 md:p-8">
      <h2 class="font-display text-3xl font-bold text-hvac-text">{c.painPoint.headline}</h2>
      <p class="mt-3 max-w-3xl font-body text-hvac-muted">{c.painPoint.body}</p>

      <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-3">
        {c.painPoint.metrics.map((m) => (
          <div class="rounded-md border border-hvac-border-real bg-hvac-base p-4">
            <div class="font-display text-4xl font-bold text-hvac-urgent">{m.value}</div>
            <div class="mt-1 text-sm font-medium text-hvac-text">{m.label}</div>
            <a
              href={m.source}
              target="_blank"
              rel="noreferrer"
              class="mt-1 inline-block text-[11px] font-semibold uppercase tracking-wide text-hvac-muted underline-offset-2 hover:text-hvac-brand hover:underline"
            >
              Fuente
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SOLUTION ── -->
  <section class="mx-auto max-w-7xl px-4 py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.solution.eyebrow}</p>
    <h2 class="mt-2 max-w-3xl font-display text-3xl font-bold text-hvac-text md:text-4xl">
      {t.sections.solution.headline}
    </h2>
    <p class="mt-3 max-w-3xl font-body text-hvac-muted">{t.sections.solution.body}</p>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {t.solutionSteps.map((step, i) => (
        <div class="rounded-lg border border-hvac-border-real bg-hvac-surface p-4">
          <div class="flex items-center justify-between">
            <span class="flex h-9 w-9 items-center justify-center rounded-md border border-hvac-brand bg-hvac-brand/10 text-hvac-brand">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stepIcons[i]} />
            </span>
            <span class="font-display text-3xl font-bold text-hvac-neutral">0{i + 1}</span>
          </div>
          <h3 class="mt-3 font-display text-lg font-semibold text-hvac-text">{step.title}</h3>
          <p class="mt-1 text-sm text-hvac-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── DASHBOARD INTERACTIVO ── -->
  <section class="mx-auto max-w-7xl px-4 py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.dashboard.eyebrow}</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-hvac-text">{t.sections.dashboard.headline}</h2>
    <p class="mt-3 max-w-3xl font-body text-hvac-muted">{t.sections.dashboard.body}</p>
    <div class="mt-6">
      <Dashboard client:load locale={locale} />
    </div>
  </section>

  <!-- ── SOCIAL PROOF + integraciones ── -->
  <section class="mx-auto max-w-7xl px-4 py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.proof.eyebrow}</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-hvac-text">{t.sections.proof.headline}</h2>

    <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
      {c.proof.map((p, i) => (
        <div class="rounded-lg border border-hvac-border-real bg-hvac-surface p-5">
          <span
            class={`inline-block rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${
              p.type === 'statistic'
                ? 'border-hvac-brand text-hvac-brand'
                : p.type === 'case_study'
                  ? 'border-hvac-accent text-hvac-accent'
                  : 'border-hvac-on-route text-hvac-on-route'
            }`}
          >
            {p.type === 'statistic' ? 'Estadística' : p.type === 'case_study' ? 'Caso de estudio' : 'Testimonio'}
          </span>
          <p class="mt-3 font-body text-hvac-text">{p.text}</p>
          {p.source && (
            <a
              href={p.source}
              target="_blank"
              rel="noreferrer"
              class="mt-2 inline-block text-[11px] font-semibold uppercase tracking-wide text-hvac-muted underline-offset-2 hover:text-hvac-brand hover:underline"
            >
              Fuente
            </a>
          )}
          {!p.source && <div class="mt-2 h-[1px] w-full bg-hvac-border-real" aria-hidden />}
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-lg border border-hvac-border-real bg-hvac-surface p-5">
      <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-hvac-text">
        {t.integrationsTitle}
      </h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {config.integrations.map((it) => (
          <span
            key={it.name}
            class="inline-flex items-center gap-1.5 rounded-full border border-hvac-border-real bg-hvac-base px-3 py-1 text-xs font-semibold text-hvac-text"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-hvac-on-route" aria-hidden="true"></span>
            {it.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ROI ── -->
  <section class="mx-auto max-w-7xl px-4 py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.roi.eyebrow}</p>
    <h2 class="mt-2 max-w-3xl font-display text-3xl font-bold text-hvac-text">{t.sections.roi.headline}</h2>
    <p class="mt-3 max-w-2xl font-body text-hvac-muted">{c.painPoint.metrics[2].value} por trabajo perdido — esto es lo que suma en tu caso.</p>
    <div class="mt-6 max-w-md">
      <ROICalculator client:load />
    </div>
  </section>

  <!-- ── CTA FINAL (Calendly, NUNCA mailto) ── -->
  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="rounded-lg border border-hvac-brand bg-hvac-surface p-8 text-center md:p-12">
      <p class="font-mono text-xs uppercase tracking-widest text-hvac-brand">{t.sections.cta.eyebrow}</p>
      <h2 class="mt-2 font-display text-4xl font-bold text-hvac-text">{t.sections.cta.headline}</h2>
      <p class="mx-auto mt-3 max-w-2xl font-body text-hvac-muted">{t.sections.cta.body}</p>
      <a
        href={config.cta.url}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-md border border-hvac-brand bg-hvac-brand px-8 py-4 font-display text-xl font-bold uppercase tracking-wide text-white transition-colors hover:bg-hvac-brand-strong"
      >
        {t.ctaLabel}
      </a>
      <p class="mt-4 font-mono text-[11px] text-hvac-muted">{t.footer.estimated}</p>
    </div>
  </section>
</BaseLayout>
