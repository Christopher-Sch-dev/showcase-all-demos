---
/**
 * LANDING ES es-CL (`/es/`) — demo-lead-qualifier, nicho Real Estate (dark luxury).
 * Misma composición editorial que `/`: Hero → métricas → PainPoint → Solution → ROI → Proof → CTA.
 * El copy de narrativa viene de `esNarrative` (no está en el contrato Zod, que es monolingüe);
 * la UI viene de `strings.es` y la paleta de `config.aesthetic`. Las métricas con su fuente NO
 * se traducen: son datos del estudio citado.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNicheConfig } from '../../config';
import { strings, esNarrative } from '../../i18n/strings';
import DemoShell from '../../components/DemoShell';
import ROICalculator from '../../components/ROICalculator';
import CTACalendly from '../../components/ui/CTACalendly';

const config = getNicheConfig('realestate')!;
const t = strings.es;
const n = esNarrative;

// rol: pasos del funnel que muestra el marco del hero (mismo flujo que la versión EN).
const flow = [
  { label: 'Capturado', at: '0.0s' },
  { label: 'Puntuado', at: '0.4s' },
  { label: 'Calificado', at: '1.2s' },
  { label: 'Agendado', at: '43s' },
];
---

<BaseLayout
  title="Respuesta de IA para Leads de Real Estate — bajo 60s"
  description="Un lead entra, se responde, se califica y se agenda en menos de 60 segundos. 100x más probable contactar un lead en 5 minutos que en 30. Mira el sistema en vivo."
  config={config}
  lang="es"
  canonical="/es/"
>
  {/* ── HERO ── */}
  <section class="relative overflow-hidden pb-24 pt-16 sm:pb-32 sm:pt-24">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-40 h-[38rem]"
      style={{
        background:
          'radial-gradient(ellipse 60% 50% at 50% 0%, color-mix(in srgb, var(--brand-accent) 16%, transparent), transparent 70%)',
      }}
    >
    </div>

    <div class="lq-container relative">
      <div class="grid items-center gap-x-20 gap-y-16 lg:grid-cols-[1.08fr_0.92fr]">
        <div>
          <p class="lq-eyebrow lq-enter">{n.heroEyebrow}</p>

          <h1
            class="lq-enter lq-enter-2 mt-7"
            style={{
              fontFamily: 'var(--brand-display), Georgia, serif',
              fontSize: 'var(--lq-fs-hero)',
              lineHeight: 0.94,
              letterSpacing: '-0.035em',
              fontWeight: 400,
              color: 'var(--brand-text)',
            }}
          >
            {n.heroHeadline}
          </h1>

          <p class="lq-lead lq-enter lq-enter-3 mt-8">{n.heroSubheadline}</p>

          <div class="lq-enter lq-enter-4 mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a
              href="#solution"
              class="inline-flex min-h-[52px] items-center justify-center px-8 text-[0.78rem] font-medium uppercase tracking-[0.16em] transition-transform duration-300 hover:-translate-y-0.5"
              style={{
                backgroundColor: 'var(--brand-accent)',
                color: 'var(--brand-bg)',
                borderRadius: 'var(--brand-radius)',
                fontFamily: 'var(--brand-body), sans-serif',
              }}
            >
              {n.heroCta}
            </a>
            <a
              href="#roi"
              class="group inline-flex min-h-[52px] items-center gap-2 text-[0.78rem] font-medium uppercase tracking-[0.16em] transition-opacity hover:opacity-70"
              style={{ color: 'var(--brand-muted)', fontFamily: 'var(--brand-body), sans-serif' }}
            >
              {t.heroCtaSecondary}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"
                >→</span
              >
            </a>
          </div>
        </div>

        {/* Marco del producto */}
        <div class="lq-enter lq-enter-3 relative">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -inset-8 rounded-[3rem] opacity-60 blur-3xl"
            style={{ background: 'radial-gradient(circle, var(--lq-accent-soft), transparent 65%)' }}
          >
          </div>

          <div
            class="relative overflow-hidden p-6 sm:p-7"
            style={{
              borderRadius: '20px',
              border: '1px solid var(--lq-border)',
              background:
                'linear-gradient(160deg, color-mix(in srgb, var(--brand-surface) 92%, var(--brand-text) 5%), var(--brand-surface))',
              boxShadow: '0 30px 80px -40px rgba(0,0,0,0.8)',
            }}
          >
            <div class="flex items-center justify-between">
              <span
                class="inline-flex items-center gap-2 text-[0.6rem] font-medium uppercase tracking-[0.2em]"
                style={{ color: 'var(--brand-muted)' }}
              >
                <span
                  class="lq-pulse inline-block h-1.5 w-1.5 rounded-full"
                  style={{ backgroundColor: 'var(--brand-accent)' }}
                  aria-hidden="true"
                ></span>
                {t.heroFlowLabel}
              </span>
              <span class="text-[0.6rem] uppercase tracking-[0.2em]" style={{ color: 'var(--brand-accent)' }}>
                &lt; 60s
              </span>
            </div>

            <div class="my-5" style={{ borderTop: '1px solid var(--lq-border-soft)' }}></div>

            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[0.7rem] font-medium tracking-wide"
                style={{ backgroundColor: 'var(--lq-accent-soft)', color: 'var(--brand-accent)' }}
              >
                MG
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-medium" style={{ color: 'var(--brand-text)' }}>
                  María González
                </p>
                <p class="truncate text-xs" style={{ color: 'var(--brand-muted)' }}>
                  4 dormitorios · North Dallas
                </p>
              </div>
              <span
                class="ml-auto shrink-0 text-2xl"
                style={{
                  fontFamily: 'var(--brand-display), serif',
                  color: 'var(--brand-accent)',
                  lineHeight: 1,
                }}
              >
                94
              </span>
            </div>

            <ol class="mt-6">
              {flow.map((step, i) => (
                <li class="flex items-center gap-3 py-2.5 text-xs" style={{ color: 'var(--brand-muted)' }}>
                  <span
                    class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[0.5rem]"
                    style={{
                      border: '1px solid var(--lq-border)',
                      backgroundColor: i === flow.length - 1 ? 'var(--brand-accent)' : 'transparent',
                      color: i === flow.length - 1 ? 'var(--brand-bg)' : 'var(--brand-muted)',
                    }}
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span style={{ color: i === flow.length - 1 ? 'var(--brand-text)' : undefined }}>
                    {step.label}
                  </span>
                  <span class="ml-auto tabular-nums" style={{ color: 'var(--brand-accent)' }}>
                    {step.at}
                  </span>
                </li>
              ))}
            </ol>

            <div
              class="mt-5 px-4 py-3 text-center text-[0.65rem] uppercase tracking-[0.18em]"
              style={{
                borderRadius: '10px',
                border: '1px solid var(--lq-accent-soft)',
                color: 'var(--brand-accent)',
                backgroundColor: 'var(--lq-accent-soft)',
              }}
            >
              {t.responseLine}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── FRANJA DE MÉTRICAS ── */}
  <section
    style={{
      borderTop: '1px solid var(--lq-border-soft)',
      borderBottom: '1px solid var(--lq-border-soft)',
    }}
  >
    <div class="lq-container grid gap-y-10 py-12 sm:grid-cols-3 sm:gap-x-12">
      {config.metrics.map((m, i) => (
        <div
          class={i > 0 ? 'sm:border-l sm:pl-12' : ''}
          style={i > 0 ? { borderColor: 'var(--lq-border-soft)' } : {}}
        >
          <p
            style={{
              fontFamily: 'var(--brand-display), serif',
              fontSize: 'clamp(2.4rem, 4vw, 3.4rem)',
              lineHeight: 1,
              letterSpacing: '-0.03em',
              color: 'var(--brand-accent)',
            }}
          >
            {m.value}
          </p>
          <p class="mt-3 max-w-[24ch] text-sm leading-snug" style={{ color: 'var(--brand-muted)' }}>
            {n.metricLabels[i] ?? m.label}
          </p>
          <a
            href={m.source}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-[32px] items-center text-[0.6rem] uppercase tracking-[0.18em] underline decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
            style={{ color: 'var(--brand-muted)' }}
          >
            {t.kpiSource} ↗
          </a>
        </div>
      ))}
    </div>
  </section>

  {/* ── PAIN POINT ── */}
  <section class="lq-section">
    <div class="lq-container grid gap-x-20 gap-y-12 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="lq-reveal">
        <p class="lq-eyebrow">{t.painEyebrow}</p>
        <h2 class="lq-h2">{n.painHeadline}</h2>
        <p class="lq-lead mt-6">{n.painBody}</p>
      </div>

      <div class="lq-reveal" style={{ backgroundColor: 'var(--lq-border-soft)' }}>
        {config.painPoint.metrics.map((m, i) => (
          <div
            class="flex items-baseline gap-6 px-1 py-6 sm:px-8"
            style={{ backgroundColor: 'var(--brand-bg)', borderBottom: '1px solid var(--brand-bg)' }}
          >
            <span
              class="shrink-0"
              style={{
                fontFamily: 'var(--brand-display), serif',
                fontSize: 'clamp(1.9rem, 3vw, 2.6rem)',
                lineHeight: 1,
                letterSpacing: '-0.03em',
                color: 'var(--brand-text)',
                minWidth: '4rem',
              }}
            >
              {m.value}
            </span>
            <div>
              <p class="text-sm leading-snug" style={{ color: 'var(--brand-muted)' }}>
                {n.metricLabels[i] ?? m.label}
              </p>
              <a
                href={m.source}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-block text-[0.6rem] uppercase tracking-[0.18em] underline decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
                style={{ color: 'var(--brand-muted)' }}
              >
                {t.kpiSource} ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── SOLUTION ── */}
  <section id="solution" class="lq-section" style={{ backgroundColor: 'var(--brand-surface)' }}>
    <div class="lq-container">
      <div class="lq-reveal max-w-3xl">
        <p class="lq-eyebrow">{n.solutionSub}</p>
        <h2 class="lq-h2">{n.solutionHeadline}</h2>
        <p class="lq-lead mt-6">{n.solutionBody}</p>
      </div>

      <div class="mt-14">
        <DemoShell client:load t={t} niche="realestate" />
      </div>
    </div>
  </section>

  {/* ── ROI ── */}
  <section id="roi" class="lq-section">
    <div class="lq-container grid gap-x-20 gap-y-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lq-reveal">
        <p class="lq-eyebrow">{t.roiEyebrow}</p>
        <h2 class="lq-h2">{n.roiTitle}</h2>
        <p class="lq-lead mt-6">{n.roiBody}</p>
      </div>
      <div class="lq-reveal">
        <ROICalculator client:load t={t} config={config} />
      </div>
    </div>
  </section>

  {/* ── PROOF ── */}
  <section class="lq-section" style={{ backgroundColor: 'var(--brand-surface)' }}>
    <div class="lq-container">
      <div class="lq-reveal">
        <p class="lq-eyebrow">{t.proofEyebrow}</p>
        <h2 class="lq-h2">{n.proofTitle}</h2>
        <p class="lq-lead mt-6">{n.proofBody}</p>
      </div>

      <div class="mt-12 grid gap-x-16 gap-y-10 sm:grid-cols-2">
        {config.proof.map((p) => (
          <figure
            class="lq-reveal"
            style={{ borderTop: '1px solid var(--lq-border)', paddingTop: '1.75rem' }}
          >
            <blockquote
              style={{
                fontFamily: 'var(--brand-display), serif',
                color: 'var(--brand-text)',
                fontSize: 'clamp(1.15rem, 1.6vw, 1.4rem)',
                fontStyle: 'italic',
                lineHeight: 1.5,
              }}
            >
              {p.text}
            </blockquote>
            {p.source && (
              <figcaption class="mt-4">
                <a
                  href={p.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[32px] items-center text-[0.6rem] uppercase tracking-[0.18em] underline decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
                  style={{ color: 'var(--brand-muted)' }}
                >
                  {t.kpiSource} ↗
                </a>
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA FINAL ── */}
  <section class="lq-section relative overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[26rem]"
      style={{
        background:
          'radial-gradient(ellipse 55% 60% at 50% 100%, color-mix(in srgb, var(--brand-accent) 14%, transparent), transparent 70%)',
      }}
    >
    </div>

    <div class="lq-container relative text-center">
      <p class="lq-eyebrow" style={{ justifyContent: 'center' }}>SIGUIENTE PASO</p>
      <h2 class="lq-h2 mx-auto mt-6 max-w-2xl" style={{ fontSize: 'clamp(2.1rem, 4vw, 3.4rem)' }}>
        Mira tu embudo trabajando en tiempo real.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base" style={{ color: 'var(--brand-muted)' }}>
        Agenda una demo gratis de 20 minutos en Calendly. Sin compromiso.
      </p>
      <div class="mt-9 flex justify-center">
        <CTACalendly
          client:load
          href={config.cta.url}
          label="Agendar demo gratis"
          radius={config.aesthetic.radius}
          accent={config.aesthetic.accent}
        />
      </div>
    </div>
  </section>
</BaseLayout>
