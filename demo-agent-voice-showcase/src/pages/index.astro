---
// rol: shell de la aplicación. El producto es el chat; esta página solo lo
// enmarca con la identidad de la clínica. La lógica vive en src/client/ y las
// reglas de negocio en src/lib/showcase.ts.
import Icon from '../components/Icon.astro';
import Assistant from '../components/Assistant.astro';
import '../styles/base.css';
import '../styles/chat.css';

const BUSINESS = {
  nombre: 'Sonrisa Vital',
  tipo: 'Clínica dental',
  ubicacion: 'Av. Libertador 1234, Santiago Centro, Chile',
  horarios: 'Lun a vie 9:00-20:00, sab 9:00-14:00',
  telefono: '+56 2 2345 6789',
  whatsapp: '+56 9 1234 5678',
  email: 'hola@sonrisavital.cl',
};

const pageTitle = `${BUSINESS.nombre} · Asistente virtual`;
const pageDesc = `Recepcionista virtual de ${BUSINESS.nombre}: responde consultas y agenda horas por chat o por voz.`;
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta name="theme-color" content="#08141c" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
  />
</head>
<body>
  <nav class="nav">
    <div class="nav__inner">
      <a class="nav__brand" href="/">
        <Icon name="tooth" size={22} />
        {BUSINESS.nombre}
      </a>
      <a class="nav__cta" href="https://christopher-sch-dev.pages.dev/#proyectos">Ver más demos</a>
    </div>
  </nav>

  <div class="layout">
    <header class="header">
      <div class="header__copy">
        <h1>Asistente virtual · {BUSINESS.nombre}</h1>
        <p class="sub">
          Recepcionista con IA que responde consultas por chat o por voz, con los datos
          reales de la clínica: servicios, precios, isapres y horarios.
        </p>
      </div>
      <div class="badges">
        <span class="badge"><span class="b-dot"></span>IA en vivo</span>
        <span class="badge">{BUSINESS.ubicacion}</span>
      </div>
    </header>

    <div class="chat-wrap">
      <div class="chat__head">
        <div class="chat__avatar"><Assistant /></div>
        <div>
          <div class="chat__name">Recepcionista virtual</div>
          <div class="chat__sub">{BUSINESS.tipo} · responde al instante</div>
        </div>
        <span class="chat__engine" id="engine">…</span>
      </div>

      <div class="chat__messages" id="messages" aria-live="polite" aria-label="Conversación"></div>

      <canvas class="viz" id="viz" width="640" height="80" aria-hidden="true"></canvas>
      <div class="chat__status" id="status" aria-live="polite"></div>

      <form class="chat__form" id="form" autocomplete="off">
        <label for="input" class="sr-only">Escribe tu pregunta</label>
        <input id="input" type="text" placeholder="Escribe tu pregunta…" autocomplete="off" />
        <button type="submit" id="send" class="btn btn--ghost btn--icon" aria-label="Enviar mensaje">
          <Icon name="send" />
        </button>
        <button type="button" id="mic" class="btn btn--ghost btn--icon" aria-label="Hablar" disabled>
          <Icon name="mic" />
        </button>
        <button type="button" id="speaker" class="btn btn--speaker btn--icon" aria-label="Escuchar la última respuesta" disabled>
          <Icon name="speaker" />
        </button>
        <button type="button" id="callbtn" class="btn btn--primary" aria-label="Iniciar llamada de voz">
          <Icon name="phone" size={16} /> Llamada
        </button>
        <button type="button" id="hangup" class="btn btn--primary" style="display:none" aria-label="Colgar la llamada">
          <Icon name="hangup" size={16} /> Colgar
        </button>
      </form>
    </div>

    <aside class="side">
      <div>
        <h2>Prueba preguntar <span class="count" id="count"></span></h2>
        <p class="hint">Toca una pregunta para verla en el chat.</p>
      </div>
      <ul class="showcase" id="showcase"></ul>

      <div class="meta">
        <strong>Sobre esta demo</strong>
        <div class="row"><span>Ubicación</span><span>{BUSINESS.ubicacion}</span></div>
        <div class="row"><span>Horarios</span><span>{BUSINESS.horarios}</span></div>
        <div class="row"><span>Teléfono</span><span><a href={"tel:" + BUSINESS.telefono}>{BUSINESS.telefono}</a></span></div>
        <div class="row"><span>WhatsApp</span><span><a href={"https://wa.me/" + BUSINESS.whatsapp.replace(/\D/g, '')} target="_blank" rel="noopener">Escribir</a></span></div>
        <div class="row"><span>Email</span><span><a href={"mailto:" + BUSINESS.email}>{BUSINESS.email}</a></span></div>
      </div>
    </aside>

    <footer>
      <p>
        Demo de {BUSINESS.nombre} ·
        <a href="https://christopher-sch-dev.pages.dev/#proyectos">Volver a demos</a> ·
        Replicable para tu PyME
      </p>
    </footer>
  </div>

  <script type="application/json" id="business-data">{"nombre": "Sonrisa Vital", "tipo": "Clinica dental", "ubicacion": "Av. Libertador 1234, Santiago Centro, Chile", "horarios": "Lun a vie 9:00-20:00, sab 9:00-14:00", "telefono": "+56 2 2345 6789", "whatsapp": "+56 9 1234 5678", "email": "hola@sonrisavital.cl", "servicios": [{"id": "limpieza", "nombre": "Limpieza profunda", "duracion": "45 min", "precio": "$25.000 CLP"}, {"id": "blanquea", "nombre": "Blanqueamiento LED", "duracion": "60 min", "precio": "$120.000 CLP"}, {"id": "orto", "nombre": "Ortodoncia invisible", "duracion": "6-12 meses", "precio": "Desde $890.000 CLP"}, {"id": "implante", "nombre": "Implante unitario", "duracion": "1-3 visitas", "precio": "Desde $450.000 CLP"}, {"id": "conducto", "nombre": "Tratamiento de conducto", "duracion": "60-90 min", "precio": "Desde $95.000 CLP"}, {"id": "urgencia", "nombre": "Urgencia dental 24/7", "duracion": "Variable", "precio": "Desde $35.000 CLP"}, {"id": "radio", "nombre": "Radiografia panoramica", "duracion": "10 min", "precio": "$18.000 CLP"}, {"id": "exodoncia", "nombre": "Extraccion simple", "duracion": "20-30 min", "precio": "Desde $28.000 CLP"}], "isapres": ["Consalud", "Cruz Blanca", "Banmedica", "Colmena", "Nueva Masvida"], "bonos": "Fonasa, con derivacion", "medios_pago": "Efectivo, tarjeta, transferencia, Webpay, Flow", "estacionamiento": "Si, gratuito para pacientes en el subterraneo del edificio", "promo": "20% off en limpieza profunda este mes", "equipo": [{"nombre": "Dra. Carolina Perez", "rol": "Directora y odontologa general"}, {"nombre": "Dr. Andres Vargas", "rol": "Especialista en ortodoncia"}, {"nombre": "Dra. Maria Jose Soto", "rol": "Endodoncia y conductos"}, {"nombre": "Dra. Francisca Leiva", "rol": "Implantologia y cirugia"}]}</script>
  <script>
    import '../client/app';
  </script>
</body>
</html>
