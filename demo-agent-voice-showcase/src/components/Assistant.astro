---
// rol: avatar de la recepcionista. Busto mínimo en SVG: le da cara al producto
// en el encabezado del chat y en el estado vacío, sin cargar ninguna imagen.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" role="img" aria-label="Recepcionista virtual de la clínica">
  <circle cx="24" cy="24" r="24" fill="var(--accent-bg)" />
  <path d="M16 46c0-7 3.6-11 8-11s8 4 8 11z" fill="var(--accent-deep)" />
  <path d="M20 30h8v7c0 2.4-1.8 4-4 4s-4-1.6-4-4z" fill="#dba477" />
  <ellipse cx="24" cy="21" rx="9.5" ry="11" fill="#f2c9ac" />
  <path d="M14.5 21c0-8 4-13 9.5-13s9.5 5 9.5 13c-1.4-4.2-3.2-6.4-5-7.2-1.6 2-4.2 3-7 2.6-2.8-.4-5 .6-6.2 3.4-.5.8-.8 1.2-.8 1.2z" fill="#263a44" />
  <circle cx="20.4" cy="21.5" r="1.4" fill="#0b1a24" />
  <circle cx="27.6" cy="21.5" r="1.4" fill="#0b1a24" />
  <path d="M21.4 26.2c1.2 1.5 4 1.5 5.2 0" fill="none" stroke="#0b1a24" stroke-opacity="0.6" stroke-width="1.3" stroke-linecap="round" />
</svg>
