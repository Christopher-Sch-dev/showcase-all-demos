---
// rol: iconos de la interfaz. SVG inline en vez de emojis: heredan currentColor,
// mantienen el mismo trazo en cualquier sistema y caben en un control de 44 px.
interface Props {
  name: 'mic' | 'phone' | 'speaker' | 'hangup' | 'send' | 'tooth' | 'stop';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  mic: '<path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><path d="M12 18v4M9 22h6"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/>',
  speaker: '<path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/>',
  hangup: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/><path d="m2 2 20 20"/>',
  send: '<path d="M22 2 11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/>',
  stop: '<rect x="6" y="6" width="12" height="12" rx="2.5" fill="currentColor" stroke="none"/>',
  tooth: '<path d="M12 3c-2.4 0-3.2 1-4.7 1C5.6 4 4 5.6 4 8.2c0 2 .7 3.3 1.2 5.1.4 1.5.5 3 .8 4.6.3 1.7.8 3.1 1.9 3.1 1.2 0 1.5-1.6 1.8-3.3.3-1.6.6-2.7 2.3-2.7s2 1.1 2.3 2.7c.3 1.7.6 3.3 1.8 3.3 1.1 0 1.6-1.4 1.9-3.1.3-1.6.4-3.1.8-4.6.5-1.8 1.2-3.1 1.2-5.1C20 5.6 18.4 4 16.7 4 15.2 4 14.4 3 12 3z"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
