  <script>
    // Nav scroll
    const nav = document.getElementById('site-nav');
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          nav.classList.toggle('nav--scrolled', window.scrollY > 40);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Scroll reveal
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

    // Team carousel — Spotlight Morph
    (function() {
      const track = document.getElementById('team-track');
      const dots = document.getElementById('carousel-dots');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      if (!track || !dots) return;

      const slides = Array.from(track.children);
      const total = slides.length;
      if (total < 2) return;

      let index = 0;
      let autoTimer = null;
      let isPaused = false;

      function positionSlides(i) {
        index = (i + total) % total;
        const isMobile = window.innerWidth < 768;
        const containerW = track.parentElement.offsetWidth;

        slides.forEach(function(slide, idx) {
          const rel = (idx - index + total) % total; // 0=active, 1=next, 2=prev

          slide.classList.remove('carousel__slide--active', 'carousel__slide--prev', 'carousel__slide--next');

          var offset, scaleVal, opacity, blurPx;
          if (rel === 0)      { offset = 0; scaleVal = 1;   opacity = 1;   blurPx = 0;   slide.classList.add('carousel__slide--active'); }
          else if (rel === 1) { offset = 1; scaleVal = 0.75; opacity = 0.35; blurPx = 4;  slide.classList.add('carousel__slide--next'); }
          else                { offset = -1; scaleVal = 0.75; opacity = 0.35; blurPx = 4;  slide.classList.add('carousel__slide--prev'); }

          var xPx = offset * (isMobile ? containerW : 356);
          slide.style.transform = 'translateX(-50%) translateX(' + xPx + 'px) scale(' + scaleVal + ')';
          slide.style.opacity = opacity;
          slide.style.filter = blurPx ? 'blur(' + blurPx + 'px)' : 'none';
          slide.style.pointerEvents = rel === 0 ? 'auto' : 'none';
        });

        // Update dots
        Array.from(dots.children).forEach(function(d, j) {
          d.classList.toggle('carousel__dot--active', j === index);
        });
      }

      function next() { positionSlides(index + 1); }
      function prev() { positionSlides(index - 1); }

      function startAuto() { stopAuto(); if (!isPaused) autoTimer = setInterval(next, 5000); }
      function stopAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
      function restartAuto() { stopAuto(); startAuto(); }

      // Build dots
      for (var i = 0; i < total; i++) {
        (function(idx) {
          var btn = document.createElement('button');
          btn.className = 'carousel__dot' + (idx === 0 ? ' carousel__dot--active' : '');
          btn.setAttribute('aria-label', 'Ir al especialista ' + (idx + 1));
          btn.addEventListener('click', function() { positionSlides(idx); restartAuto(); });
          dots.appendChild(btn);
        })(i);
      }

      nextBtn.addEventListener('click', function() { next(); restartAuto(); });
      prevBtn.addEventListener('click', function() { prev(); restartAuto(); });

      // Keyboard
      document.addEventListener('keydown', function(e) {
        if (e.target.closest('.carousel')) {
          if (e.key === 'ArrowRight') { e.preventDefault(); next(); restartAuto(); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); restartAuto(); }
        }
      });

      // Pause on hover
      var wrap = track.parentElement;
      wrap.addEventListener('mouseenter', function() { isPaused = true; stopAuto(); });
      wrap.addEventListener('mouseleave', function() { isPaused = false; startAuto(); });

      // Touch swipe
      var startX = 0;
      wrap.addEventListener('touchstart', function(e) { startX = e.changedTouches[0].screenX; }, { passive: true });
      wrap.addEventListener('touchend', function(e) {
        var diff = e.changedTouches[0].screenX - startX;
        if (Math.abs(diff) > 40) { if (diff < 0) { next(); restartAuto(); } else { prev(); restartAuto(); } }
      }, { passive: true });

      // Debounced resize
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() { positionSlides(index); }, 150);
      });

      // Initial render — disable transition to avoid flash
      slides.forEach(function(s) { s.style.transition = 'none'; });
      positionSlides(0);
      requestAnimationFrame(function() { requestAnimationFrame(function() { slides.forEach(function(s) { s.style.transition = ''; }); }); });

      startAuto();
    })();

    // Contact form
    const form = document.querySelector('.contact-form');
    const status = document.getElementById('form-status');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!status) return;
        const data = Object.fromEntries(new FormData(form).entries());
        const webhook = form.dataset.webhook || '';
        status.textContent = 'Enviando...';
        status.dataset.tone = 'pending';
        try {
          if (!webhook || webhook.includes('demo.n8n.io')) {
            await new Promise(r => setTimeout(r, 800));
            status.textContent = '✓ Mensaje recibido. En producción esto conectaría con N8N → CRM → WhatsApp.';
            status.dataset.tone = 'ok';
            form.reset();
            return;
          }
          const res = await fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, source: 'sonrisa-vital.landing', ts: new Date().toISOString() })
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          status.textContent = '✓ Recibido. Te confirmamos por WhatsApp en menos de 1 hora.';
          status.dataset.tone = 'ok';
          form.reset();
        } catch {
          status.textContent = '✗ No pudimos enviar. Escríbenos directo a hola@sonrisavital.cl';
          status.dataset.tone = 'err';
        }
      });
    }
  </script>
