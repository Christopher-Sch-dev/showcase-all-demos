---
// Sonrisa Vital — Landing page rediseñada
// 1 file, sin componentes, CSS inline. Diseño Dentaire sobre contenido Sonrisa Vital.
---

<!--
  THESIS: Sonrisa Vital es tu dentista de confianza en Santiago Centro, sin esperas.
  OWN-WORLD: Navy/ocean palette (#0E384C / #1E84B5 / #EFF8FF / #527282), Poppins single-font,
  tarjetas white con sombra soft, borders redondeados generosos (30px), scroll reveals sutiles.
  STORY: El visitante siente calma y confianza profesional. Reserva online en segundos.
  FIRST VIEWPORT: Hero asimétrico con headline bold, subtext, CTA primario + WhatsApp.
  FORM: Persuade — landing page de conversión, acción clara (agendar hora).
-->

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0E384C" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Sonrisa Vital — Clínica dental en Santiago Centro</title>
  <meta name="description" content="Clínica dental en Santiago Centro. Limpieza, ortodoncia invisible, implantes y urgencias 24/7. Aceptamos todas las isapres y Fonasa." />
  <link rel="canonical" href="https://demo-landing-jade-three.vercel.app" />
  <meta property="og:type" content="dentist" />
  <meta property="og:title" content="Sonrisa Vital — Clínica dental en Santiago Centro" />
  <meta property="og:description" content="Clínica dental en Santiago Centro. Limpieza, ortodoncia invisible, implantes y urgencias 24/7. Aceptamos todas las isapres y Fonasa." />
  <meta property="og:url" content="https://demo-landing-jade-three.vercel.app" />
  <meta property="og:image" content="https://demo-landing-jade-three.vercel.app/og-default.png" />
  <meta property="og:locale" content="es_CL" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Sonrisa Vital — Clínica dental en Santiago Centro" />
  <meta name="twitter:description" content="Clínica dental en Santiago Centro. Limpieza, ortodoncia invisible, implantes y urgencias 24/7." />
  <meta name="twitter:image" content="https://demo-landing-jade-three.vercel.app/og-default.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style>
    /* === Tokens === */
    :root {
      --canvas: #EFF8FF;
      --white: #FFFFFF;
      --navy: #0E384C;
      --steel: #527282;
      --ocean: #1E84B5;
      --ocean-deep: #18709A;
      --line: rgba(14,56,76,0.10);
      --gold: #FFC107;
      --red: rgb(230,87,87);
      --font: 'Poppins', system-ui, sans-serif;
      --content-max: 1320px;
      --shadow-soft: 0 4px 40px rgba(0,0,0,0.06);
      --shadow-card: 0 4px 40px rgba(14,56,76,0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font);
      color: var(--steel);
      background: var(--white);
      -webkit-font-smoothing: antialiased;
      line-height: 1.8;
    }
    h1, h2, h3, h4 { color: var(--navy); font-weight: 700; text-wrap: balance; }
    p { text-wrap: pretty; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; }
    ::selection { background: var(--ocean); color: var(--white); }

    /* === Utilities === */
    .container {
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    /* === Navigation === */
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 50;
      background: rgba(255,255,255,0.90);
      backdrop-filter: blur(8px);
      transition: box-shadow 0.3s, background 0.3s;
      border-bottom: 1px solid transparent;
    }
    .nav--scrolled {
      border-bottom-color: var(--line);
      background: rgba(255,255,255,0.95);
      box-shadow: 0 1px 4px rgba(14,56,76,0.06);
    }
    .nav__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 0 24px;
    }
    .nav__brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--navy);
    }
    .nav__brand-icon {
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      border-radius: 50%;
      background: var(--ocean);
      color: var(--white);
      font-size: 1.1rem;
    }
    .nav__links {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .nav__links a {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--steel);
      transition: color 0.2s;
    }
    .nav__links a:hover { color: var(--ocean); }
    .nav__cta {
      background: var(--ocean) !important;
      color: var(--white) !important;
      padding: 10px 24px;
      border-radius: 99px;
      font-weight: 600 !important;
      font-size: 0.875rem !important;
      transition: background 0.2s, transform 0.2s !important;
    }
    .nav__cta:hover {
      background: var(--ocean-deep) !important;
      transform: translateY(-1px);
      color: var(--white) !important;
    }
    .nav__toggle {
      display: none;
      background: none;
      border: 1px solid var(--line);
      border-radius: 8px;
      width: 42px;
      height: 42px;
      font-size: 1.2rem;
      color: var(--navy);
      cursor: pointer;
    }

    /* === Hero === */
    .hero {
      background: var(--canvas);
      padding: 140px 0 80px;
    }
    .hero__grid {
      display: grid;
      gap: 48px;
      align-items: center;
    }
    .hero__content {
      max-width: 640px;
    }
    .hero__overline {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--ocean);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 16px;
    }
    .hero__title {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 700;
      line-height: 1.1;
      color: var(--navy);
      margin-bottom: 20px;
    }
    .hero__hl {
      color: var(--ocean);
    }
    .hero__sub {
      font-size: 1rem;
      color: var(--steel);
      line-height: 1.8;
      margin-bottom: 32px;
      max-width: 540px;
    }
    .hero__actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 32px;
      border-radius: 99px;
      font-weight: 600;
      font-size: 0.875rem;
      transition: background 0.2s, transform 0.2s;
      cursor: pointer;
      border: 1.5px solid transparent;
    }
    .btn--primary {
      background: var(--ocean);
      color: var(--white);
    }
    .btn--primary:hover {
      background: var(--ocean-deep);
      transform: translateY(-1px);
    }
    .btn--ghost {
      background: transparent;
      color: var(--navy);
      border-color: var(--ocean);
    }
    .btn--ghost:hover {
      background: rgba(30,132,181,0.06);
      transform: translateY(-1px);
    }
    .hero__visual {
      display: none;
    }

    /* === Stats Bar === */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      background: var(--line);
      border-radius: 16px;
      overflow: hidden;
      max-width: 640px;
    }
    .stats__item {
      background: var(--white);
      padding: 20px 16px;
      text-align: center;
    }
    .stats__number {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--navy);
      line-height: 1.1;
    }
    .stats__label {
      font-size: 0.85rem;
      color: var(--steel);
      margin-top: 4px;
    }

    /* === Section pattern === */
    .section {
      padding: 80px 0;
    }
    .section--alt {
      background: var(--canvas);
    }
    .section__header {
      text-align: center;
      margin-bottom: 48px;
    }
    .section__overline {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--ocean);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 12px;
    }
    .section__title {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 700;
      color: var(--navy);
      line-height: 1.2;
    }
    .section__sub {
      color: var(--steel);
      max-width: 600px;
      margin: 12px auto 0;
      font-size: 0.95rem;
    }

    /* === Services === */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
    }
    .service-card {
      background: var(--white);
      border-radius: 30px;
      padding: 30px;
      box-shadow: var(--shadow-card);
      transition: transform 0.3s, box-shadow 0.3s;
      border: 1px solid var(--line);
    }
    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 50px rgba(14,56,76,0.12);
    }
    .service-card__icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--canvas);
      color: var(--ocean);
      font-size: 1.2rem;
      margin-bottom: 16px;
      transition: background 0.3s, color 0.3s;
    }
    .service-card:hover .service-card__icon {
      background: var(--ocean);
      color: var(--white);
    }
    .service-card__title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 8px;
    }
    .service-card__desc {
      font-size: 0.9rem;
      color: var(--steel);
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .service-card__price {
      font-weight: 600;
      color: var(--ocean);
      font-size: 1.05rem;
    }

    /* === Team Carousel — Spotlight Morph === */
    .carousel {
      position: relative;
      max-width: 840px;
      margin: 0 auto;
    }
    .carousel__track-wrap {
      position: relative;
      min-height: 180px;
      overflow: hidden;
    }
    .carousel__track {
      position: relative;
      height: 100%;
    }
    .carousel__slide {
      position: absolute;
      left: 50%;
      top: 0;
      width: 100%;
      max-width: 340px;
      padding: 0 8px;
      transition: all 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform, opacity, filter;
    }
    .carousel__slide--active {
      z-index: 3;
      filter: none !important;
    }
    .carousel__slide--prev,
    .carousel__slide--next {
      z-index: 1;
      pointer-events: none;
    }

    .team-card {
      background: var(--white);
      border-radius: 20px;
      padding: 28px 24px;
      box-shadow: var(--shadow-card);
      border: 1px solid var(--line);
      display: flex;
      gap: 20px;
      align-items: flex-start;
      transition: box-shadow 0.3s;
    }
    .team-card__avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--canvas);
      color: var(--ocean);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 1.2rem;
      flex-shrink: 0;
      transition: background 0.3s, color 0.3s;
    }
    .carousel__slide--active .team-card__avatar {
      background: var(--ocean);
      color: var(--white);
    }
    .team-card__name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--navy);
    }
    .team-card__role {
      font-size: 0.85rem;
      color: var(--ocean);
      margin-top: 2px;
    }
    .team-card__exp {
      font-size: 0.85rem;
      color: var(--steel);
      margin-top: 4px;
    }

    /* Carousel controls */
    .carousel__controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 28px;
    }
    .carousel__arrow {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid var(--line);
      background: var(--white);
      color: var(--navy);
      font-size: 0.9rem;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .carousel__arrow:hover {
      background: var(--ocean);
      border-color: var(--ocean);
      color: var(--white);
    }
    .carousel__dots {
      display: flex;
      gap: 8px;
    }
    .carousel__dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: none;
      background: var(--line);
      cursor: pointer;
      transition: background 0.3s, transform 0.3s;
      padding: 0;
    }
    .carousel__dot--active {
      background: var(--ocean);
      transform: scale(1.35);
      box-shadow: 0 0 0 3px rgba(30,132,181,0.2);
    }
    .carousel__dot:hover {
      background: var(--ocean);
      transform: scale(1.15);
    }

    /* === FAQ === */
    .faq__grid {
      position: relative;
    }
    .faq__visual {
      display: none;
    }
    .faq__mascot {
      width: 100%;
      height: auto;
      display: block;
    }
    .section--faq {
      position: relative;
    }
    .faq-list {
      max-width: 720px;
      margin: 0 auto;
    }
    .faq-item {
      border-bottom: 1px solid var(--line);
      padding: 20px 0;
    }
    .faq-item:first-child {
      border-top: 1px solid var(--line);
    }
    .faq-q {
      font-weight: 600;
      font-size: 1rem;
      color: var(--navy);
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-q::after {
      content: "\f078";
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      font-size: 0.8rem;
      color: var(--ocean);
      transition: transform 0.2s;
    }
    details[open] .faq-q::after {
      transform: rotate(180deg);
    }
    .faq-a {
      color: var(--steel);
      font-size: 0.9rem;
      margin-top: 12px;
      line-height: 1.7;
      max-width: 600px;
    }

    /* === Form === */
    .contact-form {
      max-width: 640px;
      margin: 0 auto;
    }
    .contact-form__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field--full { grid-column: 1 / -1; }
    .field label {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--navy);
    }
    .field input,
    .field select,
    .field textarea {
      padding: 14px 18px;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-family: var(--font);
      font-size: 0.95rem;
      color: var(--navy);
      background: var(--white);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .field input::placeholder,
    .field textarea::placeholder {
      color: var(--steel);
      opacity: 0.5;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: none;
      border-color: var(--ocean);
      box-shadow: 0 0 0 3px rgba(30,132,181,0.15);
    }
    .form-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn--submit {
      background: var(--ocean);
      color: var(--white);
      padding: 16px 32px;
      border: none;
      border-radius: 99px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn--submit:hover { background: var(--ocean-deep); }
    .form-status {
      font-size: 0.85rem;
      text-align: center;
    }
    .form-status[data-tone="ok"] { color: var(--ocean); }
    .form-status[data-tone="err"] { color: var(--red); }
    .form-status[data-tone="pending"] { color: var(--steel); }

    /* === Footer === */
    .footer {
      background: var(--navy);
      color: var(--white);
      padding: 64px 0 0;
    }
    .footer__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 40px;
      max-width: var(--content-max);
      margin: 0 auto;
      padding: 0 24px;
    }
    .footer__brand {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .footer__desc {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.55);
      line-height: 1.7;
    }
    .footer__heading {
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 16px;
    }
    .footer__link {
      display: block;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.55);
      margin-bottom: 8px;
      transition: color 0.2s;
    }
    .footer__link:hover { color: var(--white); }
    .footer__bottom {
      border-top: 1px solid rgba(255,255,255,0.12);
      margin-top: 48px;
      padding: 20px 24px;
      text-align: center;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.4);
    }
    .footer__bottom a { color: var(--ocean); }

    /* === Scroll reveal === */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* === Responsive === */
    @media (min-width: 768px) {
      .section { padding: 100px 0; }
      .hero { padding: 160px 0 80px; }
      .hero__grid {
        grid-template-columns: 1fr 1.3fr;
      }
      .hero__visual {
        display: grid;
        place-items: center;
        position: relative;
      }
      .hero__mascot {
        width: 100%;
        height: auto;
        justify-self: center;
        position: relative;
        z-index: 2;
        animation: float3d 8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
        filter: drop-shadow(0 -4px 8px rgba(255,255,255,0.08)) drop-shadow(0 25px 35px rgba(14,56,76,0.18));
      }
      .hero__visual::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 40%, rgba(30,132,181,0.1) 0%, transparent 65%);
        z-index: 0;
        animation: glowPulse 4s ease-in-out infinite;
      }
      .hero__visual::after {
        content: '';
        position: absolute;
        bottom: 12%;
        left: 50%;
        width: 65%;
        aspect-ratio: 12 / 1;
        background: radial-gradient(ellipse, rgba(14,56,76,0.12) 0%, transparent 70%);
        transform: translateX(-50%);
        z-index: 0;
        animation: shadowShift 8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
      }
      @keyframes float3d {
        0%, 100% { transform: perspective(800px) rotateY(-3deg) rotateX(2deg) translateY(0); }
        50%      { transform: perspective(800px) rotateY(3deg) rotateX(-1deg) translateY(-10px); }
      }
      @keyframes glowPulse {
        0%, 100% { opacity: 0.4; }
        50%      { opacity: 0.9; }
      }
      @keyframes shadowShift {
        0%, 100% { opacity: 0.6; width: 65%; }
        50%      { opacity: 0.25; width: 50%; }
      }
      .hero__title { font-size: clamp(2.8rem, 4.5vw, 3.6rem); }
      .services-grid { grid-template-columns: repeat(3, 1fr); }
      .faq__visual {
        display: block;
        position: absolute;
        right: -80px;
        top: 200px;
        width: min(780px, 65%);
        pointer-events: none;
      }
      .faq__mascot {
        position: relative;
        z-index: 2;
        animation: float3d 8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
        filter: drop-shadow(0 -4px 8px rgba(255,255,255,0.06)) drop-shadow(0 20px 30px rgba(14,56,76,0.12));
      }
      .faq__visual::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 40%, rgba(30,132,181,0.08) 0%, transparent 65%);
        z-index: 0;
        animation: glowPulse 4s ease-in-out infinite;
      }
      .faq__visual::after {
        content: '';
        position: absolute;
        bottom: 10%;
        left: 50%;
        width: 60%;
        aspect-ratio: 12 / 1;
        background: radial-gradient(ellipse, rgba(14,56,76,0.08) 0%, transparent 70%);
        transform: translateX(-50%);
        z-index: 0;
        animation: shadowShift 8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
      }
    }

    @media (max-width: 767px) {
      .nav__links a:not(.nav__cta) { display: none; }
      .nav__links a.nav__cta {
        font-size: 0.8rem !important;
        padding: 8px 16px;
      }
      .stats { grid-template-columns: repeat(3, 1fr); }
      .stats__number { font-size: 1.4rem; }
      .contact-form__grid { grid-template-columns: 1fr; }

      .hero__actions { justify-content: center; }
      .hero__overline,
      .hero__title,
      .hero__sub { text-align: center; }
      .hero__sub { margin-left: auto; margin-right: auto; }
      .stats { margin: 0 auto; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
