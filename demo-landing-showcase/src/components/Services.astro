---
// rol: catálogo de prestaciones con precios reales en CLP. El precio va en
// serif y deja de ser una etiqueta: es el dato que decide la reserva.
import Icon from './Icon.astro';

const services = [
  {
    icon: 'tooth' as const,
    name: 'Limpieza profunda',
    desc: 'Profilaxis con ultrasonido. 45 minutos.',
    price: '$25.000',
    note: 'incluye control',
  },
  {
    icon: 'star' as const,
    name: 'Ortodoncia invisible',
    desc: 'Alineadores transparentes a medida. 6 a 12 meses.',
    price: 'desde $890.000',
    note: 'plan a medida',
  },
  {
    icon: 'check' as const,
    name: 'Blanqueamiento LED',
    desc: 'Una sesión de 60 minutos. Resultados visibles ya.',
    price: '$120.000',
    note: 'sesión única',
  },
  {
    icon: 'shield' as const,
    name: 'Implantes dentales',
    desc: 'Implante de titanio + corona de zirconio. Garantía 5 años.',
    price: 'cotizar',
    note: 'garantía 5 años',
  },
  {
    icon: 'tooth' as const,
    name: 'Conducto (endodoncia)',
    desc: 'Con microscopio dental. 1 a 2 sesiones.',
    price: 'desde $180.000',
    note: 'microscopio',
  },
  {
    icon: 'clock' as const,
    name: 'Urgencias 24/7',
    desc: 'Dolor, fractura o infección. Respondemos en menos de 30 minutos.',
    price: 'urgencia',
    note: 'todos los días',
    urgent: true,
  },
];
---

<section class="section section--alt" id="servicios">
  <div class="container">
    <header class="services__head">
      <div>
        <p class="eyebrow">Servicios</p>
        <h2 class="h2">Equipos digitales,<br />materiales certificados.</h2>
      </div>
      <p class="lead services__note">
        Todos los precios incluyen el control post-tratamiento. Sin sorpresas al
        momento de pagar.
      </p>
    </header>

    <ul class="services__grid">
      {services.map((s) => (
        <li class:list={['card', s.urgent && 'card--urgent', 'reveal']}>
          <span class="card__icon"><Icon name={s.icon} size={19} /></span>
          <h3 class="card__name">{s.name}</h3>
          <p class="card__desc">{s.desc}</p>
          <footer class="card__foot">
            <span class="card__price">{s.price}</span>
            <span class="card__note">{s.note}</span>
          </footer>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .services__note { padding-bottom: 0.35rem; }

  .services__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(288px, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    overflow: hidden;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.4rem, 2.4vw, 2rem);
    background: var(--white);
    transition: background-color 0.3s var(--ease);
  }
  .card:hover { background: #FCFCFA; }

  .card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--ocean-soft);
    color: var(--ocean);
    margin-bottom: 0.35rem;
  }
  .card--urgent .card__icon {
    background: color-mix(in srgb, #C2410C 10%, transparent);
    color: #C2410C;
  }

  .card__name {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.22rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .card__desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
    flex: 1;
  }

  .card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-soft);
  }
  .card__price {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .card--urgent .card__price { color: #C2410C; }
  .card__note {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--muted) 75%, transparent);
  }

  @media (max-width: 820px) {
    .services__head { grid-template-columns: 1fr; align-items: start; }
  }
</style>
