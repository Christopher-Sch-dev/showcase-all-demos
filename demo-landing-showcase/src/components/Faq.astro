---
// rol: preguntas frecuentes con <details> nativo. Sin JS, accesible por teclado
// y sin el bloque decorativo que se salía del viewport (origen del scroll lateral).
import Icon from './Icon.astro';

const faqs = [
  {
    q: '¿Aceptan isapres o Fonasa?',
    a: 'Sí. Trabajamos con Consalud, Cruz Blanca, Banmédica, Colmena, Nueva Masvida y bonos Fonasa. Te entregamos el programa para reembolso al salir.',
  },
  {
    q: '¿Cuánto demora un blanqueamiento?',
    a: 'Una sesión de 60 minutos. Los resultados se ven de inmediato y se asientan a las 2 semanas. Recomendamos hacer una limpieza previa.',
  },
  {
    q: '¿Tienen financiamiento?',
    a: 'Sí, hasta 12 cuotas con tarjetas. Los tratamientos largos, como ortodoncia o implantes, tienen un plan a medida sin interés.',
  },
  {
    q: '¿Atienden urgencias?',
    a: 'Sí, 24/7 por WhatsApp. Para dolor intenso, fractura o infección respondemos en menos de 30 minutos y te derivamos a la sucursal más cercana.',
  },
];
---

<section class="section section--alt" id="preguntas">
  <div class="container faq__grid">
    <header class="faq__head">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 class="h2">Todo lo que<br />necesitas saber.</h2>
      <p class="lead faq__aside">
        ¿Quedó algo pendiente? Escríbenos por WhatsApp y te responde una persona
        del equipo, no un bot.
      </p>
      <a class="btn btn--ghost faq__cta" href="https://wa.me/56912345678" target="_blank" rel="noopener">
        Escribir por WhatsApp
        <Icon name="arrow" size={15} />
      </a>
    </header>

    <div class="faq__list">
      {faqs.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary class="faq__q">
            <span>{f.q}</span>
            <span class="faq__chevron"><Icon name="chevron" size={16} /></span>
          </summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .faq__head .h2 { margin-bottom: 1.1rem; }
  .faq__aside { max-width: 40ch; }
  .faq__cta { margin-top: 1.6rem; }

  .faq__list { border-top: 1px solid var(--line); }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(1.02rem, 1.5vw, 1.16rem);
    color: var(--navy);
    letter-spacing: -0.01em;
    transition: color 0.25s;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--ocean); }

  .faq__chevron {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--muted);
    transition: transform 0.3s var(--ease), border-color 0.3s, color 0.3s;
  }
  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
    border-color: var(--ocean);
    color: var(--ocean);
  }

  .faq__a {
    padding: 0 2.6rem 1.5rem 0;
    font-size: 0.92rem;
    line-height: 1.72;
    color: var(--muted);
    animation: faq-in 0.32s var(--ease) both;
  }
  @keyframes faq-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .faq__grid { grid-template-columns: 1fr; }
  }
</style>
