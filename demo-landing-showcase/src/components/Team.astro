---
// rol: equipo tratante. Tarjetas estáticas con iniciales: sin carousel de
// blur/scale, que distraía y forzaba repintados. La ilustración de la doctora
// aporta el rostro humano donde la página habla de personas.
import Dentist from './illustrations/Dentist.astro';
const team = [
  {
    initials: 'CM',
    name: 'Dra. Carolina Méndez',
    role: 'Directora',
    years: 12,
    focus: 'Odontología general y rehabilitación',
  },
  {
    initials: 'SR',
    name: 'Dr. Sebastián Rojas',
    role: 'Ortodoncia',
    years: 8,
    focus: 'Alineadores y ortodoncia fija',
  },
  {
    initials: 'VS',
    name: 'Dra. Valentina Soto',
    role: 'Endodoncia y estética',
    years: 6,
    focus: 'Microscopía y blanqueamiento',
  },
];
---

<section class="section" id="equipo">
  <div class="container">
    <header class="team__head">
      <div class="team__head-copy">
        <p class="eyebrow">Equipo</p>
        <h2 class="h2">Especialistas con<br />experiencia comprobada.</h2>
        <p class="lead">
          Postgrado en universidades de Chile y el extranjero. Cada tratamiento lo
          realiza el especialista del área, no un turno rotativo.
        </p>
      </div>
      <div class="team__head-visual">
        <Dentist />
      </div>
    </header>

    <ul class="team__grid">
      {team.map((m) => (
        <li class="member reveal">
          <span class="member__avatar" aria-hidden="true">{m.initials}</span>
          <div class="member__body">
            <h3 class="member__name">{m.name}</h3>
            <p class="member__role">{m.role}</p>
            <p class="member__focus">{m.focus}</p>
          </div>
          <span class="member__years">
            <strong>{m.years}</strong>
            <span>años</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.32fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.6rem);
  }
  .team__head-copy { max-width: 62ch; }
  .team__head .lead { margin-top: 1.1rem; }
  /* misma tarjeta tintada que la sala de espera: le da fondo a la figura y
     empareja el tratamiento de las dos ilustraciones */
  .team__head-visual {
    justify-self: end;
    width: 100%;
    max-width: 250px;
    background: var(--canvas);
    border: 1px solid var(--line-soft);
    border-radius: 18px;
    padding: 1rem 1rem 0;
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 820px) {
    .team__head { grid-template-columns: 1fr; }
    .team__head-visual { justify-self: start; max-width: 132px; order: -1; }
  }

  .team__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.15rem;
  }

  .member {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: clamp(1.4rem, 2.2vw, 1.8rem);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    background: var(--white);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .member:hover {
    border-color: color-mix(in srgb, var(--ocean) 35%, transparent);
    transform: translateY(-3px);
  }

  .member__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-display), Georgia, serif;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
  }

  .member__body { flex: 1; display: grid; gap: 0.15rem; }
  .member__name {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }
  .member__role { font-size: 0.8rem; color: var(--ocean); font-weight: 500; }
  .member__focus { font-size: 0.8rem; color: var(--muted); }
  /* reserva dos líneas: sin esto las tarjetas quedan de igual alto pero con
     ritmo interno distinto según cuántas líneas ocupe cada texto */
  .member__role, .member__focus { min-height: 2.4em; }

  .member__years {
    flex: none;
    display: grid;
    justify-items: center;
    line-height: 1;
  }
  .member__years strong {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--navy);
  }
  .member__years span {
    font-size: 0.688rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.25rem;
  }
</style>
