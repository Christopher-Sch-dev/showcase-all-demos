---
// rol: panel de reserva del hero. Muestra el flujo real de agenda
// (servicio → horario → confirmación) en lugar de una imagen decorativa.
import Icon from './Icon.astro';
---

<aside class="booking" aria-label="Reserva en línea">
  <div class="booking__head">
    <span class="booking__dot" aria-hidden="true"></span>
    <span class="booking__title">Reserva online</span>
    <span class="booking__live">agenda abierta</span>
  </div>

  <ol class="booking__steps">
    <li class="booking__step booking__step--done">
      <span class="booking__num"><Icon name="check" size={13} /></span>
      <span class="booking__body">
        <span class="booking__k">Servicio</span>
        <span class="booking__v">Limpieza profunda · 45 min</span>
      </span>
    </li>
    <li class="booking__step booking__step--done">
      <span class="booking__num"><Icon name="check" size={13} /></span>
      <span class="booking__body">
        <span class="booking__k">Horario</span>
        <span class="booking__v">Hoy · 18:30</span>
      </span>
    </li>
    <li class="booking__step booking__step--active">
      <span class="booking__num">3</span>
      <span class="booking__body">
        <span class="booking__k">Confirmación</span>
        <span class="booking__v">Te avisamos por WhatsApp</span>
      </span>
    </li>
  </ol>

  <div class="booking__foot">
    <span class="booking__price">
      <strong>$25.000</strong>
      <span>CLP · incluye control post-tratamiento</span>
    </span>
    <span class="booking__badge">
      <Icon name="clock" size={13} />
      Respondemos en menos de 1 hora
    </span>
  </div>
</aside>

<style>
  .booking {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 1.6rem;
    box-shadow: var(--shadow-card);
  }
  .booking__head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .booking__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2FBF71;
    box-shadow: 0 0 0 3px color-mix(in srgb, #2FBF71 18%, transparent);
  }
  .booking__title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .booking__live {
    margin-left: auto;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ocean);
    background: var(--ocean-soft);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .booking__steps { list-style: none; display: grid; gap: 0.15rem; padding-block: 1rem; }
  .booking__step { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.65rem 0; }
  .booking__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid var(--line);
    color: var(--muted);
    margin-top: 1px;
  }
  .booking__step--done .booking__num {
    background: var(--ocean);
    border-color: var(--ocean);
    color: var(--white);
  }
  .booking__step--active .booking__num {
    border-color: var(--ocean);
    color: var(--ocean);
    background: var(--ocean-soft);
  }
  .booking__body { display: grid; gap: 0.1rem; }
  .booking__k {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--muted) 80%, transparent);
  }
  .booking__v { font-size: 0.9rem; color: var(--navy); font-weight: 500; line-height: 1.4; }

  .booking__foot {
    display: grid;
    gap: 0.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }
  .booking__price { display: flex; align-items: baseline; gap: 0.5rem; }
  .booking__price strong {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .booking__price span { font-size: 0.72rem; color: var(--muted); }
  .booking__badge { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--ocean); }
</style>
