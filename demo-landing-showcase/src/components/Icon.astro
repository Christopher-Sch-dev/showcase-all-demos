---
// rol: set de iconos en SVG inline. Reemplaza el CDN de Font Awesome
// (~200 KB de icon-font) por trazos que heredan color y tamaño del texto.
interface Props {
  name: 'tooth' | 'check' | 'clock' | 'chevron' | 'arrow' | 'star' | 'phone' | 'pin' | 'shield';
  size?: number;
}
const { name, size = 20 } = Astro.props;

const paths: Record<string, string> = {
  tooth: 'M12 3c-2.2 0-3.2 1.1-4.5 1.1S5.6 3 4.9 3.6C3.7 4.6 3.5 6.6 4 9c.3 1.4.5 2.2.7 3.6.2 1.3.3 2.4.5 3.9.2 1.5.6 2.5 1.3 2.5.8 0 1-1.3 1.2-2.8.2-1.6.4-3 1.3-3s1.1 1.4 1.3 3c.2 1.5.4 2.8 1.2 2.8.7 0 1.1-1 1.3-2.5.2-1.5.3-2.6.5-3.9.2-1.4.4-2.2.7-3.6.5-2.4.3-4.4-.9-5.4C16.4 3 15.2 4.1 13.9 4.1S14.2 3 12 3Z',
  check: 'M4 12.5 9 17.5 20 6.5',
  clock: 'M12 7v5l3.5 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  chevron: 'm6 9 6 6 6-6',
  arrow: 'M5 12h14m0 0-6-6m6 6-6 6',
  star: 'm12 3.5 2.6 5.6 6.1.8-4.5 4.2 1.1 6-5.3-3-5.3 3 1.1-6L3.3 9.9l6.1-.8Z',
  phone: 'M6.5 3h3l1.5 4-2 1.5a11 11 0 0 0 5 5L15.5 11l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z',
  pin: 'M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  shield: 'M12 3 5 6v6c0 4.4 3 8.1 7 9 4-.9 7-4.6 7-9V6l-7-3Zm-2.5 9 2 2 4-4',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
