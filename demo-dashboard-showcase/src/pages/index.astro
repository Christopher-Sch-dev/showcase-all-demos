---
/**
 * LANDING EN (default) — "/". Composición de secciones: el hero muestra el
 * producto real, el problema se cuenta con la ilustración, y cierra el CTA.
 * Todo el contenido viene de getNicheConfig('dental') + strings. Acá no hay copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNicheConfig } from '../config';
import { getStrings } from '../i18n/strings';
import Hero from '../components/sections/Hero.astro';
import Pain from '../components/sections/Pain.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Roi from '../components/sections/Roi.astro';
import Proof from '../components/sections/Proof.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const config = getNicheConfig('dental')!;
const strings = getStrings('en');
const title = `${config.name} — Recover your no-shows`;
const description = config.hero.subheadline;
---

<BaseLayout config={config} strings={strings} lang="en" title={title} description={description}>
  <Hero config={config} strings={strings} />
  <Pain config={config} strings={strings} />
  <Capabilities />
  <Roi config={config} strings={strings} />
  <Proof config={config} strings={strings} />
  <FinalCta config={config} strings={strings} />
</BaseLayout>
