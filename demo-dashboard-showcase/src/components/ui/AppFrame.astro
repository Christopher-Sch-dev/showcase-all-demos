---
// rol: marco de aplicación. Presenta el producto como una ventana real en vez de
// una maqueta flotante: barra de ventana, ruta y sombra en capas.
interface Props {
  class?: string;
  route?: string;
}
const { class: className = '', route = 'app.sonrisavital.cl/backoffice' } = Astro.props;
---

<div class:list={['app-frame', className]}>
  <div class="app-frame__bar">
    <span class="app-frame__dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="app-frame__route">
      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="4" y="10" width="16" height="10" rx="2.5" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      {route}
    </span>
  </div>
  <div class="app-frame__body">
    <slot />
  </div>
</div>

<style>
  .app-frame {
    min-width: 0;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px rgba(26, 31, 38, 0.04),
      0 12px 24px -12px rgba(26, 31, 38, 0.14),
      0 40px 70px -40px rgba(26, 31, 38, 0.34);
    overflow: hidden;
  }
  .app-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--surface) 70%, var(--bg));
    border-bottom: 1px solid var(--border);
  }
  .app-frame__dots {
    display: inline-flex;
    gap: 5px;
  }
  .app-frame__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }
  .app-frame__dots i:first-child { background: color-mix(in srgb, var(--danger) 55%, var(--border)); }
  .app-frame__dots i:nth-child(2) { background: color-mix(in srgb, var(--warning) 55%, var(--border)); }
  .app-frame__dots i:last-child { background: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .app-frame__route {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.16rem 0.6rem;
  }
  .app-frame__body {
    min-width: 0;
    padding: clamp(0.75rem, 1.6vw, 1.15rem);
  }
</style>
