---
// rol: la recepcionista que opera el sistema. Personaje recurrente de la página:
// acompaña el hero y guía los pasos. SVG original, hereda los tokens del nicho.
interface Props {
  class?: string;
  /** Ancho del texto del globo. Omitir = sin globo. */
  bubble?: string;
}

const { class: className = '', bubble } = Astro.props;
---

<svg
  class:list={['assistant', className]}
  viewBox="0 0 200 260"
  role="img"
  aria-label="Recepcionista de la clínica sosteniendo una tablet"
>
  {bubble && (
    <g transform="translate(126 20)">
      <rect x="0" y="0" width="74" height="34" rx="10" fill="var(--surface)" stroke="var(--accent)" stroke-width="2" />
      <path d="M6 34l-2 9 10-9" fill="var(--surface)" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" />
      <text
        x="37" y="21"
        text-anchor="middle"
        font-family="var(--font-body), sans-serif"
        font-size="11"
        font-weight="600"
        fill="var(--accent-strong)">{bubble}</text>
    </g>
  )}

  <!-- sombra en el piso -->
  <ellipse cx="100" cy="246" rx="46" ry="9" fill="var(--text)" opacity="0.08" />

  <!-- piernas -->
  <g fill="var(--text)" opacity="0.78">
    <rect x="82" y="196" width="15" height="48" rx="7.5" />
    <rect x="104" y="196" width="15" height="48" rx="7.5" />
  </g>

  <!-- torso / uniforme -->
  <path
    d="M66 118c0-13 11-22 25-24h18c14 2 25 11 25 24v66c0 9-7 16-16 16H82c-9 0-16-7-16-16v-66Z"
    fill="var(--accent)"
  />
  <!-- cuello de la camisa -->
  <path d="M92 96l8 14 8-14 10 6-11 16h-14l-11-16 10-6Z" fill="var(--surface)" opacity="0.92" />
  <!-- gafete -->
  <g transform="translate(112 132)">
    <rect x="-9" y="0" width="18" height="24" rx="4" fill="var(--surface)" opacity="0.95" />
    <g fill="var(--accent-strong)" opacity="0.55">
      <rect x="-5" y="5" width="10" height="2.4" rx="1.2" />
      <rect x="-5" y="10" width="10" height="2.4" rx="1.2" />
      <rect x="-5" y="15" width="6" height="2.4" rx="1.2" />
    </g>
  </g>

  <!-- brazo derecho sosteniendo la tablet -->
  <path d="M126 136c9 4 14 12 14 22v18" stroke="var(--accent)" stroke-width="15" stroke-linecap="round" fill="none" />
  <!-- brazo izquierdo -->
  <path d="M74 136c-7 6-10 14-10 24" stroke="var(--accent)" stroke-width="15" stroke-linecap="round" fill="none" />
  <circle cx="64" cy="166" r="8.5" fill="#EDB894" />

  <!-- tablet -->
  <g transform="rotate(-8 140 190)">
    <rect x="118" y="168" width="52" height="38" rx="5" fill="var(--text)" opacity="0.88" />
    <rect x="122" y="172" width="44" height="30" rx="3" fill="var(--accent-soft)" />
    <g fill="var(--accent-strong)" opacity="0.75">
      <rect x="126" y="177" width="24" height="3" rx="1.5" />
      <rect x="126" y="184" width="34" height="3" rx="1.5" />
      <rect x="126" y="191" width="18" height="3" rx="1.5" />
    </g>
  </g>
  <circle cx="146" cy="196" r="8.5" fill="#EDB894" />

  <!-- cabeza -->
  <circle cx="100" cy="72" r="29" fill="#F2C9A8" />
  <!-- pelo -->
  <path
    d="M71 70c0-18 13-31 29-31s29 13 29 31c-4-9-9-13-15-15-4 5-13 7-22 6-8-1-13 2-21 9Z"
    fill="var(--text)"
    opacity="0.82"
  />
  <!-- cara -->
  <g fill="var(--text)" opacity="0.85">
    <circle cx="90" cy="73" r="2.6" />
    <circle cx="110" cy="73" r="2.6" />
  </g>
  <path d="M92 84c4.6 5 11.4 5 16 0" stroke="var(--text)" stroke-width="2.6" stroke-linecap="round" fill="none" opacity="0.62" />
  <!-- mejillas -->
  <g fill="var(--lavender)" opacity="0.35">
    <circle cx="82" cy="82" r="4.6" />
    <circle cx="118" cy="82" r="4.6" />
  </g>
</svg>

<style>
  .assistant {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
