---
// Sonrisa Vital — CRUD Pacientes
// 1 file, CSS inline + external merged. Identico al deploy de Vercel.
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Sonrisa Vital — Gestión de pacientes (demo)</title>
  <meta name="description" content="Demo de gestión de pacientes para clínicas dentales. CRUD completo con localStorage. Aplicable a talleres, restaurantes, servicios.">
  <link rel="canonical" href="https://demo-crud-three.vercel.app">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Sonrisa Vital — Gestión de pacientes (demo)">
  <meta property="og:description" content="Demo de gestión de pacientes para clínicas dentales. CRUD completo con localStorage. Aplicable a talleres, restaurantes, servicios.">
  <meta property="og:url" content="https://demo-crud-three.vercel.app">
  <meta property="og:image" content="https://demo-crud-three.vercel.app/og-default.png">
  <meta property="og:locale" content="es_CL">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Sonrisa Vital — Gestión de pacientes (demo)">
  <meta name="twitter:description" content="Demo de gestión de pacientes para clínicas dentales. CRUD completo con localStorage. Aplicable a talleres, restaurantes, servicios.">
  <meta name="twitter:image" content="https://demo-crud-three.vercel.app/og-default.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#0a0a0a;--card-bg:#111;--text:#e0e0e0;--text-secondary:#a0a0a0;--text-muted:#707070;--accent:#00ff41;--border:#222;--font-sans:"Inter", system-ui, sans-serif}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:var(--font-sans);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;line-height:1.5}
    a{color:inherit}::selection{background:var(--accent);color:var(--bg)}
    .sr-only{clip:rect(0,0,0,0);white-space:nowrap;border:0;width:1px;height:1px;margin:-1px;padding:0;position:absolute;overflow:hidden}
    .nav{z-index:100;backdrop-filter:blur(12px);border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg) 90%,transparent);position:sticky;top:0}
    .nav__inner{display:flex;justify-content:space-between;align-items:center;gap:24px;max-width:1200px;margin:0 auto;padding:16px 24px}
    .nav__brand{font-family:"Plus Jakarta Sans",var(--font-sans);color:var(--text);display:flex;align-items:center;gap:8px;font-weight:700}
    .nav__brand:hover{text-decoration:none}
    .nav__logo{color:var(--accent);font-size:1.4rem}
    .nav__sep{color:var(--text-muted);margin:0 4px;font-weight:400}
    .nav__links{display:flex;align-items:center;gap:24px}
    .nav__links a{color:var(--text-secondary);font-size:.95rem;font-weight:500}
    .nav__cta{background:var(--accent);color:var(--bg);border-radius:6px;cursor:pointer;border:none;padding:8px 16px;transition:background .15s}
    .nav__cta--ghost{color:var(--text-secondary);border:1px solid var(--border);background:transparent}
    .nav__cta--ghost:hover{background:var(--card-bg)}
    .hero__eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.12em;margin-bottom:12px;font-family:monospace;font-size:.85rem}
    .crud{max-width:1200px;margin:0 auto;padding:48px 24px}
    .crud__header{margin-bottom:32px}
    .crud__title{font-family:"Plus Jakarta Sans",var(--font-sans);font-size:2rem;font-weight:700}
    .crud__sub{color:var(--text-secondary);max-width:640px;margin-top:8px}
    .crud__stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:24px}
    .crud__stats>div{background:var(--card-bg);border:1px solid var(--border);border-radius:6px;display:flex;flex-direction:column;gap:2px;padding:16px 20px}
    .crud__stats span{font-family:"Plus Jakarta Sans",var(--font-sans);color:var(--accent);font-size:1.8rem;font-weight:700}
    .crud__stats small{color:var(--text-muted);font-size:.8rem}
    .crud__toolbar{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0 16px}
    .crud__search{border:1px solid var(--border);border-radius:6px;min-width:240px;font-family:var(--font-sans);background:var(--card-bg);flex:1;padding:10px 14px;font-size:.95rem;color:var(--text)}
    .crud__filter{border:1px solid var(--border);border-radius:6px;font-family:var(--font-sans);background:var(--card-bg);padding:10px 14px;font-size:.95rem;color:var(--text)}
    .crud__search:focus,.crud__filter:focus{border-color:var(--accent);outline:none}
    .crud__table-wrap{background:var(--card-bg);border:1px solid var(--border);border-radius:6px;overflow:hidden}
    .crud__table{border-collapse:collapse;width:100%}
    .crud__table th,.crud__table td{text-align:left;padding:12px 16px;font-size:.9rem}
    .crud__table th{background:color-mix(in srgb,var(--bg) 95%,var(--accent));color:var(--text-secondary);text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--border);font-size:.8rem;font-weight:600}
    .crud__table tbody tr{border-top:1px solid var(--border)}
    .crud__table tbody tr:hover{background:color-mix(in srgb,var(--bg) 97%,var(--accent))}
    .crud__table code{color:var(--text-secondary);font-family:monospace;font-size:.85rem}
    .crud__loading,.crud__empty{text-align:center;color:var(--text-muted);padding:32px}
    .crud__actions{display:flex;gap:4px}
    .btn-icon{border:1px solid var(--border);width:32px;height:32px;color:var(--text-secondary);cursor:pointer;background:transparent;border-radius:6px;display:inline-flex;justify-content:center;align-items:center;font-size:1rem;transition:all .15s}
    .btn-icon:hover{background:color-mix(in srgb,var(--accent) 15%,transparent);color:var(--accent);border-color:var(--accent)}
    .btn-icon--danger:hover{color:#c0392b;background:#3a1a1a;border-color:#c0392b}
    .badge{text-transform:uppercase;letter-spacing:.05em;border-radius:12px;padding:2px 10px;font-size:.75rem;font-weight:600;display:inline-block}
    .badge--activo{background:color-mix(in srgb,var(--accent) 15%,transparent);color:var(--accent)}
    .badge--inactivo{color:#777;background:#2a2a2a}
    .badge--pendiente{color:#c97a00;background:#2a2200}
    .btn{border-radius:6px;cursor:pointer;font-size:.9rem;font-weight:600;font-family:var(--font-sans);border:1px solid transparent;padding:10px 20px;transition:all .15s;display:inline-block}
    .btn--primary{background:var(--accent);color:var(--bg)}
    .btn--primary:hover{opacity:.9}
    .btn--ghost{color:var(--text);border-color:var(--border);background:transparent}
    .btn--ghost:hover{border-color:var(--accent);color:var(--accent)}
    .modal{border:1px solid var(--border);border-radius:6px;background:var(--card-bg);width:92%;max-width:560px;padding:0;color:var(--text)}
    .modal::backdrop{backdrop-filter:blur(4px);background:rgba(0,0,0,.5)}
    .modal__form{display:flex;flex-direction:column;gap:14px;padding:32px}
    .modal__title{font-family:"Plus Jakarta Sans",var(--font-sans);font-size:1.3rem;font-weight:700}
    .field{display:flex;flex-direction:column;gap:4px}
    .field label{color:var(--text-secondary);font-size:.85rem;font-weight:500}
    .field input,.field select{font-family:var(--font-sans);border:1px solid var(--border);background:var(--bg);border-radius:6px;padding:10px 12px;font-size:.95rem;color:var(--text)}
    .field input:focus,.field select:focus{border-color:var(--accent);outline:none}
    .modal__actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
    .site-footer{border-top:1px solid var(--border);text-align:center;margin-top:60px;padding:24px}
    .site-footer__copy{color:var(--text-muted);font-size:.85rem}
    @media(max-width:900px){
      .crud__stats{grid-template-columns:repeat(2,1fr)}
      .crud__table th:nth-child(4),.crud__table td:nth-child(4),
      .crud__table th:nth-child(5),.crud__table td:nth-child(5),
      .crud__table th:nth-child(6),.crud__table td:nth-child(6){display:none}
    }
    @media(max-width:600px){
      .crud__table th:nth-child(2),.crud__table td:nth-child(2){display:none}
    }
  </style>
</head>
<body>
  <header class="nav" role="banner">
    <div class="nav__inner">
      <a href="https://demo-crud-three.vercel.app" class="nav__brand" aria-label="Sonrisa Vital">
        <span class="nav__logo" aria-hidden="true">◉</span>
        <span>Sonrisa Vital <span class="nav__sep">/</span> Pacientes</span>
      </a>
      <nav class="nav__links" aria-label="Navegación">
        <a href="https://demo-crud-three.vercel.app">← Demo de gestión de pacientes</a>
        <a href="#" id="reset-btn" class="nav__cta nav__cta--ghost">Reset datos</a>
      </nav>
    </div>
  </header>
  <main class="crud">
    <header class="crud__header">
      <p class="hero__eyebrow">// Panel interno · Clínica dental</p>
      <h1 class="crud__title">Pacientes</h1>
      <p class="crud__sub">Buscá, filtrá y editá a tus pacientes. Los datos viven en tu navegador para esta demo — en producción se conectan a una base de datos del estudio.</p>
      <div class="crud__stats">
        <div><span id="stat-total">—</span><small>total</small></div>
        <div><span id="stat-active">—</span><small>activos</small></div>
        <div><span id="stat-inactive">—</span><small>inactivos</small></div>
        <div><span id="stat-pending">—</span><small>pendientes</small></div>
      </div>
    </header>
    <div class="crud__toolbar">
      <input type="search" id="search" placeholder="Buscar por nombre, RUT o email..." class="crud__search" aria-label="Buscar paciente">
      <select id="filter-estado" class="crud__filter" aria-label="Filtrar por estado">
        <option value="">Todos los estados</option>
        <option value="activo">activo</option>
        <option value="inactivo">inactivo</option>
        <option value="pendiente">pendiente</option>
      </select>
      <button id="new-btn" class="btn btn--primary">+ Nuevo paciente</button>
    </div>
    <div class="crud__table-wrap">
      <table class="crud__table" role="table">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">RUT</th>
            <th scope="col">Email</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Última visita</th>
            <th scope="col">Tratamiento</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody id="pacientes-body">
          <tr><td colspan="8" class="crud__loading">Cargando...</td></tr>
        </tbody>
      </table>
      <p id="empty-msg" class="crud__empty" hidden>No hay pacientes que coincidan con tu búsqueda.</p>
    </div>
  </main>
  <dialog id="edit-modal" class="modal" aria-labelledby="modal-title">
    <form id="edit-form" method="dialog" class="modal__form">
      <h2 id="modal-title" class="modal__title">Nuevo paciente</h2>
      <input type="hidden" id="f-id" name="id">
      <div class="field">
        <label for="f-nombre">Nombre completo</label>
        <input type="text" id="f-nombre" name="nombre" required minlength="3" autocomplete="name">
      </div>
      <div class="field">
        <label for="f-rut">RUT</label>
        <input type="text" id="f-rut" name="rut" required placeholder="12.345.678-9">
      </div>
      <div class="field">
        <label for="f-email">Email</label>
        <input type="email" id="f-email" name="email" required autocomplete="email">
      </div>
      <div class="field">
        <label for="f-telefono">Teléfono</label>
        <input type="tel" id="f-telefono" name="telefono" required autocomplete="tel" placeholder="+56 9 1234 5678">
      </div>
      <div class="field">
        <label for="f-tratamiento">Tratamiento actual</label>
        <input type="text" id="f-tratamiento" name="tratamiento" required>
      </div>
      <div class="field">
        <label for="f-estado">Estado</label>
        <select id="f-estado" name="estado" required>
          <option value="activo">activo</option>
          <option value="inactivo">inactivo</option>
          <option value="pendiente">pendiente</option>
        </select>
      </div>
      <div class="field">
        <label for="f-ultima">Última visita</label>
        <input type="date" id="f-ultima" name="ultimaVisita" required>
      </div>
      <div class="modal__actions">
        <button type="button" id="cancel-btn" class="btn btn--ghost">Cancelar</button>
        <button type="submit" class="btn btn--primary">Guardar</button>
      </div>
    </form>
  </dialog>
  <footer class="site-footer">
    <p class="site-footer__copy">Demo MVP — datos en localStorage, no se envían a ningún servidor.</p>
  </footer>
  <script src="/src/scripts/crud.ts"></script>

</body>
</html>
